<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodHub - Live Order Status</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand: #e23744;
            --brand-dark: #c52d39;
            --pink: #fcd7dd;
            --pink-soft: #ffeef1;
        }
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            color: #1a1a1a;
        }
        .brand-red { color: var(--brand); }
        
        .tracking-card {
            background: #fff;
            border: 1px solid #f0d0d4;
            border-radius: 18px;
            padding: 2.5rem 1.75rem;
            max-width: 600px;
            margin: 3rem auto;
            text-align: center;
        }
        .queue-badge {
            display: inline-block;
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--brand);
            background: var(--pink-soft);
            border: 2px dashed var(--brand);
            padding: 0.4rem 2rem;
            border-radius: 12px;
            margin: 1rem 0;
        }
        .timer-display {
            font-size: 3rem;
            font-weight: 700;
            color: #1a1a1a;
            font-variant-numeric: tabular-nums;
        }
        /* Visual Pipeline Line and Steps */
        .progress-pipeline {
            display: flex;
            justify-content: space-between;
            position: relative;
            margin: 2.5rem 0 1.5rem;
        }
        .progress-pipeline::before {
            content: '';
            position: absolute;
            top: 22px;
            left: 8%;
            right: 8%;
            height: 4px;
            background: #f0d0d4;
            z-index: 1;
        }
        .pipeline-fill {
            position: absolute;
            top: 22px;
            left: 8%;
            width: 0%;
            height: 4px;
            background: var(--brand);
            z-index: 1;
            transition: width 0.5s linear;
        }
        .step-node {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #fff;
            border: 3px solid #f0d0d4;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            position: relative;
            z-index: 2;
            transition: all 0.4s ease;
        }
        .step-node.active {
            border-color: var(--brand);
            background: var(--brand);
            color: #fff;
            box-shadow: 0 0 0 6px var(--pink-soft);
        }
        .step-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: #7a7a7a;
            margin-top: 0.6rem;
            display: block;
        }
        .step-node.active + .step-label {
            color: var(--brand);
        }
    </style>
</head>
<body>

<!-- Changed py-3 to py-1 or py-2 -->
<nav class="navbar bg-white py-1 shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold fs-3" href="/">
            <img src="<%= images.logo %>" alt="FoodHub" style="max-height: 30px;"
     onerror="this.style.display='none';document.getElementById('brandText').style.display='inline';">
            <span id="brandText" style="display:none;">food<span class="brand-red">hub</span></span>
        </a>
    </div>
</nav>

<div class="container px-3">
    <div class="tracking-card shadow-sm">
        <h3 class="fw-bold mb-1">Live Order Status</h3>
        <p class="text-muted small">Order Reference: <span id="lblOrderId" class="fw-semibold">--------</span></p>

        <div class="my-4">
            <span class="text-muted text-uppercase fw-bold small d-block" style="letter-spacing: 0.5px;">Your Queue Number</span>
            <div class="queue-badge" id="lblQueueNumber">---</div>
        </div>

        <div class="progress-pipeline">
            <div class="pipeline-fill" id="pipelineFill"></div>
            <div class="text-center">
                <div class="step-node active" id="node-1">⏳</div>
                <span class="step-label">Received</span>
            </div>
            <div class="text-center">
                <div class="step-node" id="node-2">🍳</div>
                <span class="step-label">Preparing</span>
            </div>
            <div class="text-center">
                <div class="step-node" id="node-3">📦</div>
                <span class="step-label">Ready</span>
            </div>
        </div>

        <!-- Dynamic Receipt Section -->
        <div class="py-3 border-bottom text-start my-4" id="receiptBlock" style="display:none;">
            <span class="text-muted d-block small mb-2 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Your Receipt</span>
            <div id="receiptLines" class="mb-2"></div>
        </div>

        <div class="py-3 border-top border-bottom my-4">
            <span class="text-muted d-block small mb-1">Estimated Preparation Remaining</span>
            <div class="timer-display" id="lblCountdown">00:00</div>
        </div>

        <!-- Guest Warning / Sign up Callout -->
        <div class="alert alert-warning text-start mb-4" id="guestSignupAlert" style="border-radius: 12px; display: none;">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span>💡</span>
                <strong style="font-size: 0.9rem;">Order placed as Guest</strong>
            </div>
            <p class="mb-2 small text-secondary">Sign up now to save this order to an account profile, earn rewards, and unlock faster checkouts next time!</p>
            <button class="btn btn-sm btn-danger fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#signupModal" style="border-radius: 6px; background-color: var(--brand); border: none;">Sign Up</button>
        </div>

        <div class="row g-2">
            <div class="col-6"><a href="/menu" class="btn btn-light w-100 py-2.5 fw-semibold border text-secondary" style="border-radius:10px;">Browse Menu</a></div>
            <div class="col-6"><a href="/" class="btn btn-dark w-100 py-2.5 fw-semibold" style="border-radius:10px; background-color:#1a1a1a;">Go Home</a></div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
    const orderId = localStorage.getItem('fh_active_order_id');
    const queueNum = localStorage.getItem('fh_active_queue_num');
    let targetTimestamp = localStorage.getItem('fh_active_target_time');
    const receiptData = localStorage.getItem('fh_active_receipt');

    if (!orderId || !queueNum || !targetTimestamp) {
        document.getElementById('lblOrderId').textContent = "No active order";
        document.getElementById('lblCountdown').textContent = "--:--";
        return;
    }

    document.getElementById('lblOrderId').textContent = orderId;
    document.getElementById('lblQueueNumber').textContent = `#${queueNum}`;

    // --- Render Receipt Items ---
    if (receiptData) {
        try {
            const items = JSON.parse(receiptData);
            const receiptBlock = document.getElementById('receiptBlock');
            const receiptLines = document.getElementById('receiptLines');
            
            if (items && items.length > 0) {
                let html = '';
                items.forEach(item => {
                    html += `
                        <div class="d-flex justify-content-between align-items-center py-1 font-monospace" style="font-size: 0.88rem;">
                            <span>${item.name} <span class="text-muted">x${item.qty}</span></span>
                            <span>$${(item.price * item.qty).toFixed(2)}</span>
                        </div>`;
                });
                receiptLines.innerHTML = html;
                receiptBlock.style.display = 'block';
            }
        } catch (e) {
            console.error("Error formatting summary layout receipt:", e);
        }
    }

    // --- Guest Authentication Verification Check ---
    // Since accounts are not hooked up completely yet, checking if they are a guest profile:
    const userIsAuthenticated = false; // Toggle/replace with standard session logic later
    if (!userIsAuthenticated) {
        document.getElementById('guestSignupAlert').style.display = 'block';
    }

    const node2 = document.getElementById('node-2');
    const node3 = document.getElementById('node-3');
    const fill = document.getElementById('pipelineFill');
    const clock = document.getElementById('lblCountdown');

    const initialTotalDuration = parseInt(localStorage.getItem('fh_active_duration_total') || "480", 10);

    const timerEngine = setInterval(() => {
        const now = Math.floor(Date.now() / 1000);
        const remaining = targetTimestamp - now;

        if (remaining <= 0) {
            clearInterval(timerEngine);
            clock.textContent = "Ready for Pick Up!";
            clock.style.color = "#198754"; 
            fill.style.width = "84%";
            node2.classList.add('active');
            node3.classList.add('active');
            
            // Clear items cleanly
            localStorage.removeItem('fh_active_order_id');
            localStorage.removeItem('fh_active_queue_num');
            localStorage.removeItem('fh_active_target_time');
            localStorage.removeItem('fh_active_duration_total');
            localStorage.removeItem('fh_active_receipt');
            return;
        }

        const mins = Math.floor(remaining / 60).toString().padStart(2, '0');
        const secs = (remaining % 60).toString().padStart(2, '0');
        clock.textContent = `${mins}:${secs}`;

        const elapsed = initialTotalDuration - remaining;
        const progressPercentage = Math.min(Math.max((elapsed / initialTotalDuration) * 84, 0), 84);
        fill.style.width = `${progressPercentage}%`;

        if (progressPercentage >= 15) node2.classList.add('active');
        if (progressPercentage >= 75) node3.classList.add('active');

    }, 1000);
});

</script>
</body>
</html>
