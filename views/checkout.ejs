<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodHub - Checkout</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --brand: #e23744;
            --brand-dark: #c52d39;
            --pink: #fcd7dd;
            --pink-soft: #ffeef1;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            color: #1a1a1a;
        }

        .brand-red { color: var(--brand); }

        .navbar-brand img { height: 64px; }
        .back-link { color: #6b4a4f; text-decoration: none; font-weight: 500; }
        .back-link:hover { color: var(--brand); }

        .checkout-card {
            background: #fff;
            border: 1px solid #f0d0d4;
            border-radius: 18px;
            padding: 1.75rem;
        }
        .block-title { font-weight: 700; margin-bottom: 1.25rem; }

        .summary-line { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 0; border-bottom: 1px solid #f0d0d4; font-size: 0.92rem; }
        .summary-line .qty { color: #7a7a7a; font-weight: 500; }
        .summary-total { display: flex; justify-content: space-between; font-weight: 700; font-size: 1.15rem; padding-top: 1rem; }
        .summary-empty { text-align: center; color: #7a7a7a; padding: 2.5rem 1rem; }
        .summary-empty a { color: var(--brand); }

        .form-label { font-weight: 500; font-size: 0.85rem; }
        .form-control { border-radius: 10px; padding: 0.65rem 0.9rem; }
        .form-control:focus { border-color: var(--brand); box-shadow: 0 0 0 0.2rem rgba(226, 55, 68, 0.15); }
        .invalid-msg { color: var(--brand); font-size: 0.78rem; margin-top: 0.25rem; display: none; }
        .field-error .form-control { border-color: var(--brand); }
        .field-error .invalid-msg { display: block; }

        .btn-pay {
            background: var(--brand);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 0.8rem;
            font-weight: 600;
            width: 100%;
            font-size: 1rem;
            transition: 0.2s;
        }
        .btn-pay:hover:not(:disabled) { background: var(--brand-dark); color: #fff; }
        .btn-pay:disabled { opacity: 0.6; cursor: not-allowed; }

        .demo-hint {
            background: var(--pink-soft);
            border: 1px dashed #e0a4ac;
            border-radius: 10px;
            font-size: 0.8rem;
            color: #6b4a4f;
            padding: 0.7rem 0.9rem;
        }
        #payAlert { display: none; border-radius: 10px; font-size: 0.88rem; padding: 0.7rem 0.9rem; }
        .lock-note { font-size: 0.75rem; color: #7a7a7a; }

        /* ---- Payment method chooser ---- */
        .pay-methods { display: grid; gap: 0.6rem; margin-bottom: 1.4rem; }
        @media (min-width: 576px) { .pay-methods { grid-template-columns: repeat(3, 1fr); } }

        .pay-method {
            border: 1.5px solid #f0d0d4;
            background: #fff;
            border-radius: 14px;
            padding: 0.9rem 0.8rem;
            text-align: left;
            cursor: pointer;
            transition: 0.15s;
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
        }
        .pay-method:hover { border-color: #e0a4ac; }
        .pay-method.active { border-color: var(--brand); background: var(--pink-soft); }
        .pay-method .pm-top { display: flex; align-items: center; gap: 0.45rem; }
        .pay-method .pm-name { font-weight: 600; font-size: 0.92rem; }
        .pay-method .pm-sub { font-size: 0.72rem; color: #7a7a7a; line-height: 1.3; }
        .pay-method .pm-badge {
            margin-left: auto; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.3px;
            background: var(--brand); color: #fff; border-radius: 20px; padding: 0.1rem 0.45rem;
        }

        .pay-panel { display: none; }
        .pay-panel.active { display: block; }

        /* ---- Card fields ---- */
        .card-input-wrap { position: relative; }
        .card-brand-mark {
            position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%);
            font-size: 0.68rem; font-weight: 700; letter-spacing: 0.4px;
            color: #6b4a4f; background: var(--pink-soft); border-radius: 5px;
            padding: 0.18rem 0.4rem; opacity: 0; transition: opacity 0.15s;
        }
        .card-brand-mark.show { opacity: 1; }
        .accepted-brands { display: flex; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.45rem; }
        .accepted-brands span {
            font-size: 0.62rem; font-weight: 600; color: #7a7a7a;
            border: 1px solid #eee; border-radius: 4px; padding: 0.12rem 0.35rem;
        }

        /* ---- PayNow ---- */
        .paynow-box { text-align: center; padding: 0.5rem 0; }
        .paynow-qr {
            width: 232px; height: 232px; border-radius: 14px; background: #fff;
            border: 1px solid #f0d0d4; padding: 0.5rem; margin: 0 auto 0.9rem; display: block;
        }
        .paynow-amount { font-size: 1.5rem; font-weight: 700; }
        .paynow-ref {
            display: inline-block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.78rem; background: var(--pink-soft); color: var(--brand);
            border-radius: 6px; padding: 0.2rem 0.55rem; margin-top: 0.3rem;
        }
        .paynow-wait { display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.85rem; color: #6b4a4f; margin-top: 0.9rem; }
        .paynow-timer { font-size: 0.76rem; color: #7a7a7a; margin-top: 0.35rem; }
        .paynow-settled { color: #1a7f4b; font-weight: 600; }

        .counter-note {
            background: var(--pink-soft); border-radius: 12px; padding: 1rem 1.1rem;
            font-size: 0.85rem; color: #6b4a4f; line-height: 1.55;
        }

        .success-wrap { display: none; text-align: center; }
        .success-check {
            width: 84px;
            height: 84px;
            border-radius: 50%;
            background: var(--pink-soft);
            color: var(--brand);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.6rem;
            margin: 0 auto 1rem;
        }
        .success-sub { color: #6b4a4f; }
        .order-id {
            display: inline-block;
            background: var(--pink-soft);
            color: var(--brand);
            font-weight: 700;
            letter-spacing: 1px;
            border-radius: 8px;
            padding: 0.4rem 1rem;
            margin: 0.5rem 0 1.25rem;
        }

        /* Login-required banner + auth modals (reused pattern from home/menu pages) */
        .login-banner {
            background: var(--pink-soft);
            border: 1px dashed var(--brand);
            border-radius: 12px;
            padding: 0.9rem 1.2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .auth-modal .modal-content { border: none; border-radius: 18px; overflow: hidden; }
        .auth-header {
            background: linear-gradient(120deg, #fde2e7 0%, #f9c4cd 100%);
            text-align: center;
            padding: 1.75rem 1.5rem 1.25rem;
            position: relative;
        }
        .auth-header h5 { font-weight: 700; margin-top: 0.75rem; margin-bottom: 0; }
        .auth-header p { font-size: 0.85rem; color: #6b4a4f; margin: 0; }
        .auth-body { padding: 1.5rem; }
        .code-hint { font-size: 0.8rem; color: #7a7a7a; }
        .auth-body .input-group-text { background: var(--pink-soft); border-color: #dee2e6; font-weight: 600; color: #1a1a1a; }
        .field-err { display: none; color: var(--brand); font-size: 0.78rem; margin-top: 0.3rem; }
        .btn-auth { background: var(--brand); color: #fff; border: none; border-radius: 10px; padding: 0.65rem; font-weight: 600; width: 100%; }
        .btn-link-brand { background: none; border: none; color: var(--brand); font-size: 0.82rem; font-weight: 500; padding: 0; }
        .btn-link-brand:hover { text-decoration: underline; }
        .auth-switch { font-size: 0.85rem; text-align: center; margin-top: 1rem; }
        .auth-switch a { color: var(--brand); text-decoration: none; font-weight: 600; cursor: pointer; }
        .auth-switch a:hover { text-decoration: underline; }

        /* Footer */
        footer { background: #1a1a1a; color: #ddd; }
        footer a { color: #ddd; text-decoration: none; }
        footer a:hover { color: var(--brand); }
        footer h6 { font-weight: 600; margin-bottom: 1rem; color: #fff; }
        .footer-logo { height: 64px; }
        .footer-text { font-size: 0.85rem; color: #aaa; }
        footer ul { list-style: none; padding-left: 0; }
        footer ul li { margin-bottom: 0.5rem; font-size: 0.88rem; }
        .footer-divider { border-color: #333; }
        .social a {
            display: inline-flex;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #2a2a2a;
            align-items: center;
            justify-content: center;
            margin-right: 0.4rem;
            font-size: 0.78rem;
        }
        .social a:hover { background: var(--brand); color: #fff; }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar bg-white py-3 shadow-sm">
    <div class="container">
        <a class="navbar-brand" href="/">
            <img src="<%= images.logo %>" alt="FoodHub"
                 onerror="this.style.display='none';document.getElementById('brandText').style.display='inline';">
            <span id="brandText" style="display:none;">food<span class="brand-red">hub</span></span>
        </a>
        <a href="/menu" class="back-link">&larr; Back to menu</a>
    </div>
</nav>

<section class="container py-5" id="checkoutMain">
    <h1 class="fw-bold mb-4" style="font-size: clamp(1.8rem, 4vw, 2.6rem);">Checkout</h1>

    <!-- Login reminder — shown until the user is signed in -->
    <div class="login-banner mb-4" id="loginBanner" style="<%= user ? 'display:none;' : '' %>">
        <div>🔒 Please log in to complete your order.</div>
        <button type="button" class="btn btn-danger btn-sm" style="background: var(--brand); border: none;" data-bs-toggle="modal" data-bs-target="#loginModal">Login / Sign Up</button>
    </div>

    <div class="row g-4">
        <!-- Order summary (right on desktop, top on mobile) -->
        <div class="col-lg-5 order-lg-2">
            <div class="checkout-card">
                <h5 class="block-title">Order summary</h5>
                <div id="summaryLines"></div>
                <div class="summary-total">
                    <span>Total</span>
                    <span id="summaryTotal">$0.00</span>
                </div>
            </div>
        </div>

        <!-- Payment form -->
        <div class="col-lg-7 order-lg-1">
            <div class="checkout-card">
                <h5 class="block-title">Your details</h5>

                <div class="alert alert-danger" id="payAlert" role="alert"></div>

                <form id="payForm" novalidate>
                    <div class="mb-3" id="f-name">
                        <label class="form-label" for="name">Name</label>
                        <input type="text" class="form-control" id="name" placeholder="Your name" autocomplete="name">
                        <div class="invalid-msg">Enter your name.</div>
                    </div>

                    <div class="mb-4" id="f-email">
                        <label class="form-label" for="email">Email</label>
                        <input type="email" class="form-control" id="email" placeholder="you@example.com" autocomplete="email">
                        <div class="invalid-msg">Enter a valid email address.</div>
                    </div>

                    <h5 class="block-title mb-3">How would you like to pay?</h5>

                    <div class="pay-methods">
                        <button type="button" class="pay-method active" data-method="paynow">
                            <span class="pm-top">
                                <span>🇸🇬</span>
                                <span class="pm-name">PayNow</span>
                                <span class="pm-badge">POPULAR</span>
                            </span>
                            <span class="pm-sub">Scan with any Singapore banking app</span>
                        </button>
                        <button type="button" class="pay-method" data-method="card">
                            <span class="pm-top">
                                <span>💳</span>
                                <span class="pm-name">Card</span>
                            </span>
                            <span class="pm-sub">Visa, Mastercard, Amex, UnionPay</span>
                        </button>
                        <button type="button" class="pay-method" data-method="counter">
                            <span class="pm-top">
                                <span>🏪</span>
                                <span class="pm-name">Pay at stall</span>
                            </span>
                            <span class="pm-sub">Settle with the stall on collection</span>
                        </button>
                    </div>

                    <!-- PayNow -->
                    <div class="pay-panel active" id="panel-paynow">
                        <div class="paynow-box" id="paynowIdle">
                            <p class="text-muted small mb-3">
                                We'll generate a single-use PayNow QR for the exact amount.
                                Scan it with DBS PayLah!, OCBC, UOB TMRW or any SGQR-capable app.
                            </p>
                        </div>

                        <div class="paynow-box" id="paynowLive" style="display:none;">
                            <img class="paynow-qr" id="paynowQr" alt="PayNow QR code">
                            <div class="paynow-amount" id="paynowAmount">$0.00</div>
                            <div class="paynow-ref" id="paynowRef">—</div>
                            <div class="paynow-wait" id="paynowWait">
                                <span class="spinner-border spinner-border-sm" style="color: var(--brand);" role="status"></span>
                                <span id="paynowWaitText">Waiting for your transfer…</span>
                            </div>
                            <div class="paynow-timer" id="paynowTimer"></div>
                        </div>
                    </div>

                    <!-- Card -->
                    <div class="pay-panel" id="panel-card">
                        <div class="mb-3" id="f-card">
                            <label class="form-label" for="card">Card number</label>
                            <div class="card-input-wrap">
                                <input type="text" inputmode="numeric" class="form-control" id="card" placeholder="1234 5678 9012 3456" autocomplete="cc-number" maxlength="23">
                                <span class="card-brand-mark" id="cardBrandMark"></span>
                            </div>
                            <div class="invalid-msg" id="cardMsg">Enter a valid card number.</div>
                            <div class="accepted-brands">
                                <span>VISA</span><span>MASTERCARD</span><span>AMEX</span><span>UNIONPAY</span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3" id="f-exp">
                                <label class="form-label" for="expiry">Expiry</label>
                                <input type="text" inputmode="numeric" class="form-control" id="expiry" placeholder="MM/YY" autocomplete="cc-exp" maxlength="5">
                                <div class="invalid-msg">Use MM/YY, in the future.</div>
                            </div>
                            <div class="col-6 mb-3" id="f-cvv">
                                <label class="form-label" for="cvv"><span id="cvvLabel">CVV</span></label>
                                <input type="text" inputmode="numeric" class="form-control" id="cvv" placeholder="123" autocomplete="cc-csc" maxlength="4">
                                <div class="invalid-msg" id="cvvMsg">3 digits.</div>
                            </div>
                        </div>

                        <div class="demo-hint">
                            Sandbox cards — <strong>4242 4242 4242 4242</strong> approves.
                            <strong>4000 0000 0000 9995</strong> returns insufficient funds,
                            <strong>4000 0000 0000 0002</strong> is declined by the issuer.
                            Any future expiry and a valid-length CVV.
                        </div>
                    </div>

                    <!-- Pay at stall -->
                    <div class="pay-panel" id="panel-counter">
                        <div class="counter-note">
                            <strong>Order now, pay when you collect.</strong><br>
                            Your order goes straight to the stall and your queue number is issued
                            immediately. Pay the stallholder by cash, card or PayNow when you pick
                            it up — they'll mark it as settled.
                        </div>
                    </div>

                    <button type="submit" class="btn-pay mt-3" id="payBtn">Pay $0.00</button>
                    <p class="lock-note text-center mt-2" id="lockNote">&#128274; Simulated checkout for demonstration.</p>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Success state (shown briefly before redirecting to the order-tracking receipt) -->
<section class="container py-5">
    <div class="success-wrap" id="successWrap">
        <div class="checkout-card mx-auto" style="max-width: 520px;">
            <div class="success-check">&check;</div>
            <h3 class="fw-bold" id="successHeading">Payment approved</h3>
            <p class="success-sub mb-1">Thanks, <span id="successName">there</span> - your order is confirmed.</p>
            <div class="order-id" id="successOrderId">FH-000000</div>
            <p class="mb-1">Total: <strong id="successTotal">$0.00</strong></p>
            <p class="text-muted small mb-4" id="successPaymentDetail"></p>
            <p class="text-muted small">Taking you to your order status...</p>
        </div>
    </div>
</section>

<%- include('partials/footer') %>

<!-- Login Modal -->
<div class="modal fade auth-modal" id="loginModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="auth-header">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                <img src="<%= images.logo %>" alt="FoodHub" style="height:56px;">
                <h5>Welcome Back</h5>
                <p>Log in with your phone number</p>
            </div>
            <div class="auth-body">
                <div id="loginStep1">
                    <div class="mb-3">
                        <label class="form-label">Phone number</label>
                        <div class="input-group">
                            <span class="input-group-text">+65</span>
                            <input type="tel" id="loginPhone" class="form-control" placeholder="9123 4567" autocomplete="tel" maxlength="9">
                        </div>
                        <div id="loginPhoneErr" class="field-err">Enter a valid 8-digit Singapore number (starts with 6, 8 or 9).</div>
                    </div>
                    <button type="button" id="loginSendBtn" class="btn-auth">Send Security Code</button>
                </div>
                <div id="loginStep2" style="display:none;">
                    <p class="code-hint mb-3">
                        We sent a 6-digit code to <strong id="loginSentTo"></strong>.
                        <br>Demo code (no real SMS is sent): <strong id="loginDevCode" class="brand-red"></strong>
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Security code</label>
                        <input type="text" inputmode="numeric" maxlength="6" id="loginCode" class="form-control" placeholder="● ● ● ● ● ●">
                        <div id="loginCodeErr" class="field-err">Enter the 6-digit code.</div>
                    </div>
                    <button type="button" id="loginVerifyBtn" class="btn-auth">Verify &amp; Login</button>
                    <div class="text-center mt-2">
                        <button type="button" class="btn-link-brand" id="loginResend">Use a different number</button>
                    </div>
                </div>
                <p class="auth-switch">
                    Don't have an account?
                    <a data-bs-toggle="modal" data-bs-target="#signupModal" data-bs-dismiss="modal">Sign Up</a>
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Sign Up Modal -->
<div class="modal fade auth-modal" id="signupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="auth-header">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                <img src="<%= images.logo %>" alt="FoodHub" style="height:56px;">
                <h5>Create Account</h5>
                <p>Join FoodHub in two quick steps</p>
            </div>
            <div class="auth-body">
                <div id="signupStep1">
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" id="signupName" class="form-control" placeholder="Your name" autocomplete="name">
                        <div id="signupNameErr" class="field-err">Please enter your name.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone number</label>
                        <div class="input-group">
                            <span class="input-group-text">+65</span>
                            <input type="tel" id="signupPhone" class="form-control" placeholder="9123 4567" autocomplete="tel" maxlength="9">
                        </div>
                        <div id="signupPhoneErr" class="field-err">Enter a valid 8-digit Singapore number (starts with 6, 8 or 9).</div>
                    </div>
                    <button type="button" id="signupSendBtn" class="btn-auth">Send Security Code</button>
                </div>
                <div id="signupStep2" style="display:none;">
                    <p class="code-hint mb-3">
                        We sent a 6-digit code to <strong id="signupSentTo"></strong>.
                        <br>Demo code (no real SMS is sent): <strong id="signupDevCode" class="brand-red"></strong>
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Security code</label>
                        <input type="text" inputmode="numeric" maxlength="6" id="signupCode" class="form-control" placeholder="● ● ● ● ● ●">
                        <div id="signupCodeErr" class="field-err">Enter the 6-digit code.</div>
                    </div>
                    <button type="button" id="signupVerifyBtn" class="btn-auth">Create Account</button>
                    <div class="text-center mt-2">
                        <button type="button" class="btn-link-brand" id="signupResend">Edit details</button>
                    </div>
                </div>
                <p class="auth-switch">
                    Already have an account?
                    <a data-bs-toggle="modal" data-bs-target="#loginModal" data-bs-dismiss="modal">Login</a>
                </p>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/cart.js"></script>
<script>
    let isLoggedIn = <%= user ? 'true' : 'false' %>;

    // ---- Auth (same phone + code flow as the rest of the app) ----
    (function () {
        function closeModal(id) {
            const inst = bootstrap.Modal.getInstance(document.getElementById(id));
            if (inst) inst.hide();
        }
        function showStep(prefix, step) {
            document.getElementById(prefix + 'Step1').style.display = step === 1 ? 'block' : 'none';
            document.getElementById(prefix + 'Step2').style.display = step === 2 ? 'block' : 'none';
        }
        const cleanPhone = v => v.replace(/\s+/g, '');
        const validPhone = v => /^[689]\d{7}$/.test(cleanPhone(v));
        const validCode  = v => /^\d{6}$/.test(v.replace(/\s+/g, ''));

        function setupOtp(prefix, opts) {
            const phone = document.getElementById(prefix + 'Phone');
            const code  = document.getElementById(prefix + 'Code');

            document.getElementById(prefix + 'SendBtn').addEventListener('click', function () {
                if (opts.requireName) {
                    const name = document.getElementById(prefix + 'Name');
                    if (!name.value.trim()) {
                        document.getElementById(prefix + 'NameErr').style.display = 'block';
                        return;
                    }
                    document.getElementById(prefix + 'NameErr').style.display = 'none';
                }
                if (!validPhone(phone.value)) {
                    document.getElementById(prefix + 'PhoneErr').style.display = 'block';
                    return;
                }
                document.getElementById(prefix + 'PhoneErr').style.display = 'none';

                const body = { phone: cleanPhone(phone.value) };
                if (opts.requireName) body.name = document.getElementById(prefix + 'Name').value.trim();

                fetch('/auth/send-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                })
                .then(r => r.json())
                .then(result => {
                    if (!result.success) {
                        const err = document.getElementById(prefix + 'PhoneErr');
                        err.textContent = result.message;
                        err.style.display = 'block';
                        return;
                    }
                    document.getElementById(prefix + 'SentTo').textContent = '+65 ' + cleanPhone(phone.value);
                    document.getElementById(prefix + 'DevCode').textContent = result.devCode;
                    showStep(prefix, 2);
                    code.value = '';
                    code.focus();
                });
            });

            document.getElementById(prefix + 'VerifyBtn').addEventListener('click', function () {
                if (!validCode(code.value)) {
                    document.getElementById(prefix + 'CodeErr').style.display = 'block';
                    return;
                }
                document.getElementById(prefix + 'CodeErr').style.display = 'none';

                const body = { phone: cleanPhone(phone.value), code: code.value.trim() };
                if (opts.requireName) body.name = document.getElementById(prefix + 'Name').value.trim();

                fetch('/auth/verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                })
                .then(r => r.json())
                .then(result => {
                    if (!result.success) {
                        const err = document.getElementById(prefix + 'CodeErr');
                        err.textContent = result.message;
                        err.style.display = 'block';
                        return;
                    }
                    isLoggedIn = true;
                    document.getElementById('loginBanner').style.display = 'none';
                    closeModal(prefix + 'Modal');
                    showStep(prefix, 1);
                });
            });

            document.getElementById(prefix + 'Resend').addEventListener('click', function () {
                showStep(prefix, 1);
            });
        }

        setupOtp('login', { requireName: false });
        setupOtp('signup', { requireName: true });
    })();

    // ---- Order summary ----
    const summaryLines = document.getElementById('summaryLines');
    const summaryTotal = document.getElementById('summaryTotal');
    const payBtn = document.getElementById('payBtn');
    const payForm = document.getElementById('payForm');
    const payAlert = document.getElementById('payAlert');
    const lockNote = document.getElementById('lockNote');

    const cardInput = document.getElementById('card');
    const expInput = document.getElementById('expiry');
    const cvvInput = document.getElementById('cvv');
    const cardBrandMark = document.getElementById('cardBrandMark');
    const cvvLabel = document.getElementById('cvvLabel');
    const cvvMsg = document.getElementById('cvvMsg');

    let selectedMethod = 'paynow';

    function renderSummary() {
        const cart = getCart();
        if (cart.length === 0) {
            summaryLines.innerHTML = '<div class="summary-empty">Your cart is empty.<br><a href="/menu">Browse the menu</a> to add dishes.</div>';
            summaryTotal.textContent = formatPrice(0);
            payBtn.disabled = true;
            payBtn.textContent = 'Pay $0.00';
            return;
        }
        let html = '';
        cart.forEach(item => {
            html += `
                <div class="summary-line">
                    <span>${item.name} <span class="qty">&times; ${item.qty}</span></span>
                    <span>${formatPrice(item.price * item.qty)}</span>
                </div>`;
        });
        summaryLines.innerHTML = html;
        summaryTotal.textContent = formatPrice(cartTotal());
        payBtn.disabled = false;
        updatePayButton();
    }

    // Prices shown here are indicative only — the server re-prices the whole
    // cart from the database before charging anything.
    function updatePayButton() {
        const total = formatPrice(cartTotal());
        if (selectedMethod === 'paynow') {
            payBtn.textContent = paynow.reference ? 'Waiting for PayNow…' : 'Generate PayNow QR · ' + total;
            payBtn.disabled = getCart().length === 0 || !!paynow.reference;
        } else if (selectedMethod === 'counter') {
            payBtn.textContent = 'Place order · ' + total;
            payBtn.disabled = getCart().length === 0;
        } else {
            payBtn.textContent = 'Pay ' + total;
            payBtn.disabled = getCart().length === 0;
        }
    }

    // ---- Payment method switching ----
    document.querySelectorAll('.pay-method').forEach(btn => {
        btn.addEventListener('click', () => {
            const method = btn.dataset.method;
            if (method === selectedMethod) return;

            selectedMethod = method;
            document.querySelectorAll('.pay-method').forEach(b => b.classList.toggle('active', b === btn));
            document.querySelectorAll('.pay-panel').forEach(p => {
                p.classList.toggle('active', p.id === 'panel-' + method);
            });

            resetPayNow();
            payAlert.style.display = 'none';
            lockNote.textContent = method === 'counter'
                ? '🏪 No payment is taken now — settle with the stall on collection.'
                : '🔒 Simulated checkout for demonstration.';
            updatePayButton();
        });
    });

    // ---- Card: brand detection mirrors the server's rules ----
    const CARD_BRANDS = [
        { brand: 'amex',       label: 'AMEX',       pattern: /^3[47]/,           lengths: [15],             cvv: 4, cvvName: 'CID', gaps: [4, 10] },
        { brand: 'visa',       label: 'VISA',       pattern: /^4/,               lengths: [16, 19],         cvv: 3, cvvName: 'CVV', gaps: [4, 8, 12, 16] },
        { brand: 'mastercard', label: 'MASTERCARD', pattern: /^(5[1-5]|2[2-7])/, lengths: [16],             cvv: 3, cvvName: 'CVC', gaps: [4, 8, 12] },
        { brand: 'unionpay',   label: 'UNIONPAY',   pattern: /^62/,              lengths: [16, 17, 18, 19], cvv: 3, cvvName: 'CVN', gaps: [4, 8, 12, 16] }
    ];

    function detectBrand(digits) {
        return CARD_BRANDS.find(b => b.pattern.test(digits)) || null;
    }

    function groupCardDigits(digits, brand) {
        const gaps = brand ? brand.gaps : [4, 8, 12, 16];
        let out = '';
        for (let i = 0; i < digits.length; i++) {
            if (i > 0 && gaps.includes(i)) out += ' ';
            out += digits[i];
        }
        return out;
    }

    cardInput.addEventListener('input', () => {
        const brandBefore = detectBrand(cardInput.value.replace(/\D/g, ''));
        const maxLen = brandBefore ? Math.max(...brandBefore.lengths) : 19;
        const digits = cardInput.value.replace(/\D/g, '').slice(0, maxLen);
        const brand = detectBrand(digits);

        cardInput.value = groupCardDigits(digits, brand);

        if (brand) {
            cardBrandMark.textContent = brand.label;
            cardBrandMark.classList.add('show');
            cvvLabel.textContent = brand.cvvName;
            cvvInput.maxLength = brand.cvv;
            cvvInput.placeholder = brand.cvv === 4 ? '1234' : '123';
            cvvMsg.textContent = brand.cvv + ' digits.';
            if (cvvInput.value.length > brand.cvv) cvvInput.value = cvvInput.value.slice(0, brand.cvv);
        } else {
            cardBrandMark.classList.remove('show');
            cvvLabel.textContent = 'CVV';
            cvvInput.maxLength = 4;
            cvvMsg.textContent = '3 digits.';
        }
    });

    expInput.addEventListener('input', () => {
        let digits = expInput.value.replace(/\D/g, '').slice(0, 4);
        if (digits.length >= 3) digits = digits.slice(0, 2) + '/' + digits.slice(2);
        expInput.value = digits;
    });

    cvvInput.addEventListener('input', () => {
        cvvInput.value = cvvInput.value.replace(/\D/g, '').slice(0, cvvInput.maxLength || 4);
    });

    function luhnValid(number) {
        const digits = number.replace(/\D/g, '');
        if (!/^\d{12,19}$/.test(digits)) return false;
        let sum = 0;
        let double = false;
        for (let i = digits.length - 1; i >= 0; i--) {
            let d = Number(digits[i]);
            if (double) { d *= 2; if (d > 9) d -= 9; }
            sum += d;
            double = !double;
        }
        return sum % 10 === 0;
    }

    function expiryValid(value) {
        const match = value.match(/^(\d{2})\/(\d{2})$/);
        if (!match) return false;
        const month = Number(match[1]);
        const year = 2000 + Number(match[2]);
        if (month < 1 || month > 12) return false;
        return new Date(year, month, 1) > new Date();
    }

    function setError(fieldId, hasError) {
        document.getElementById(fieldId).classList.toggle('field-error', hasError);
    }

    // Validates the contact fields plus whatever the chosen method needs.
    // The server repeats all of this — this is only to save a round trip.
    function validateForm() {
        const name = document.getElementById('name').value.trim();
        const email = document.getElementById('email').value.trim();

        const checks = {
            'f-name': name.length > 0,
            'f-email': /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
        };

        if (selectedMethod === 'card') {
            const digits = cardInput.value.replace(/\D/g, '');
            const brand = detectBrand(digits);
            checks['f-card'] = !!brand && brand.lengths.includes(digits.length) && luhnValid(digits);
            checks['f-exp'] = expiryValid(expInput.value);
            checks['f-cvv'] = new RegExp('^\\d{' + (brand ? brand.cvv : 3) + '}$').test(cvvInput.value);
        }

        let valid = true;
        for (const fieldId in checks) {
            setError(fieldId, !checks[fieldId]);
            if (!checks[fieldId]) valid = false;
        }
        if (!valid) return null;

        return { name: name, email: email };
    }

    // ---- PayNow ----
    const paynow = { reference: null, poll: null, countdown: null, settled: false };

    function resetPayNow() {
        clearInterval(paynow.poll);
        clearInterval(paynow.countdown);
        paynow.reference = null;
        paynow.settled = false;
        document.getElementById('paynowIdle').style.display = '';
        document.getElementById('paynowLive').style.display = 'none';
    }

    function startPayNow(contact) {
        payBtn.disabled = true;
        payBtn.textContent = 'Generating QR…';

        fetch('/api/payments/paynow', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: getCart() })
        })
        .then(r => r.json())
        .then(result => {
            if (!result.success) {
                showError(result.message || 'Could not start the PayNow payment.');
                updatePayButton();
                return;
            }

            paynow.reference = result.reference;
            document.getElementById('paynowIdle').style.display = 'none';
            document.getElementById('paynowLive').style.display = '';
            document.getElementById('paynowQr').src = result.qr;
            document.getElementById('paynowAmount').textContent = formatPrice(result.amount);
            document.getElementById('paynowRef').textContent = 'Ref ' + result.reference;

            startCountdown(result.expiresAt);
            pollPayNow(contact);
            updatePayButton();
        })
        .catch(() => {
            showError('Could not reach the server. Please try again.');
            updatePayButton();
        });
    }

    function startCountdown(expiresAt) {
        const timer = document.getElementById('paynowTimer');
        clearInterval(paynow.countdown);
        paynow.countdown = setInterval(() => {
            const left = Math.max(0, Math.round((expiresAt - Date.now()) / 1000));
            const mm = String(Math.floor(left / 60)).padStart(2, '0');
            const ss = String(left % 60).padStart(2, '0');
            timer.textContent = left > 0 ? `QR expires in ${mm}:${ss}` : 'This QR has expired.';
            if (left <= 0) clearInterval(paynow.countdown);
        }, 250);
    }

    // Polls the way a real terminal waits for the bank's confirmation push.
    function pollPayNow(contact) {
        clearInterval(paynow.poll);
        paynow.poll = setInterval(() => {
            fetch('/api/payments/paynow/' + paynow.reference)
                .then(r => r.json())
                .then(result => {
                    if (!result.success) return;

                    if (result.status === 'succeeded' && !paynow.settled) {
                        paynow.settled = true;
                        clearInterval(paynow.poll);
                        clearInterval(paynow.countdown);
                        document.getElementById('paynowWait').innerHTML =
                            '<span class="paynow-settled">✓ Transfer received — placing your order…</span>';
                        document.getElementById('paynowTimer').textContent = '';
                        submitOrder(contact, { method: 'paynow', paymentReference: paynow.reference });
                    } else if (result.status === 'expired') {
                        clearInterval(paynow.poll);
                        document.getElementById('paynowWait').innerHTML =
                            '<span class="text-muted">This QR expired before payment arrived.</span>';
                        resetPayNow();
                        showError('The PayNow QR expired. Please generate a new one.');
                        updatePayButton();
                    }
                })
                .catch(() => { /* transient — the next tick retries */ });
        }, 1200);
    }

    function showError(message) {
        payAlert.textContent = message;
        payAlert.style.display = 'block';
    }

    // ---- Order submission ----
    function submitOrder(contact, payment) {
        const cart = getCart();
        if (cart.length === 0) return;

        payBtn.disabled = true;
        const previousLabel = payBtn.textContent;
        payBtn.textContent = 'Processing…';

        fetch('/pay', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                items: cart,
                customer: { name: contact.name, email: contact.email },
                ...payment
            })
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                clearCart();
                const orders = result.orders || [];
                document.getElementById('checkoutMain').style.display = 'none';
                document.getElementById('successName').textContent = result.name || 'there';
                document.getElementById('successOrderId').textContent = orders.map(o => o.orderId).join(', ');
                document.getElementById('successTotal').textContent = formatPrice(result.total);

                const heading = document.getElementById('successHeading');
                const detail = document.getElementById('successPaymentDetail');
                if (result.paymentStatus === 'unpaid') {
                    heading.textContent = 'Order confirmed';
                    detail.textContent = 'Pay the stall when you collect.';
                } else {
                    heading.textContent = 'Payment approved';
                    detail.textContent = 'Paid with ' + (result.paymentDetail || 'card') + '.';
                }

                document.getElementById('successWrap').style.display = 'block';
                window.scrollTo({ top: 0, behavior: 'smooth' });
                setTimeout(() => {
                    window.location.href = orders.length === 1 ? '/track/' + orders[0].orderId : '/orders';
                }, 1600);
            } else {
                showError(result.message || 'Payment failed. Please try again.');
                resetPayNow();
                updatePayButton();
                payBtn.textContent = previousLabel;
                if (result.message && result.message.toLowerCase().includes('log in')) {
                    isLoggedIn = false;
                    document.getElementById('loginBanner').style.display = 'flex';
                }
            }
        })
        .catch(() => {
            showError('Could not reach the server. Please try again.');
            resetPayNow();
            updatePayButton();
        });
    }

    payForm.addEventListener('submit', event => {
        event.preventDefault();
        payAlert.style.display = 'none';

        if (!isLoggedIn) {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('loginModal')).show();
            return;
        }

        const contact = validateForm();
        if (!contact) return;

        if (selectedMethod === 'paynow') {
            startPayNow(contact);
        } else if (selectedMethod === 'card') {
            submitOrder(contact, {
                method: 'card',
                card: { number: cardInput.value, expiry: expInput.value, cvv: cvvInput.value }
            });
        } else {
            submitOrder(contact, { method: 'counter' });
        }
    });

    renderSummary();
</script>

</body>
</html>
