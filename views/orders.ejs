<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodHub - My Orders</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --brand: #e23744;
            --brand-dark: #c52d39;
            --pink: #fcd7dd;
            --pink-soft: #ffeef1;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            color: #1a1a1a;
        }

        .brand-red { color: var(--brand); }

        .navbar-brand img { height: 64px; }
        .back-link { color: #6b4a4f; text-decoration: none; font-weight: 500; }
        .back-link:hover { color: var(--brand); }

        .order-card {
            background: #fff;
            border: 1px solid #f0d0d4;
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 1.25rem;
        }
        .order-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
        }
        .order-id-text { font-weight: 700; }
        .order-date { color: #7a7a7a; font-size: 0.85rem; }
        .order-line { display: flex; justify-content: space-between; font-size: 0.92rem; padding: 0.4rem 0; border-bottom: 1px solid #f0d0d4; }
        .order-line:last-of-type { border-bottom: none; }
        .order-total { display: flex; justify-content: space-between; font-weight: 700; padding-top: 0.75rem; }

        .status-badge { font-size: 0.75rem; font-weight: 700; border-radius: 999px; padding: 0.3rem 0.85rem; }
        .status-preparing { background: var(--pink-soft); color: var(--brand); }
        .status-ready { background: #d1f5df; color: #198754; }
        .status-collected { background: #eeeeee; color: #7a7a7a; }

        .orders-empty { text-align: center; color: #7a7a7a; padding: 4rem 1rem; }
        .orders-empty a { color: var(--brand); }

        .btn-reorder {
            background: var(--brand);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 0.5rem 1rem;
            font-weight: 600;
            font-size: 0.85rem;
        }
        .btn-reorder:hover { background: var(--brand-dark); color: #fff; }

        .btn-track {
            background: #fff;
            color: var(--brand);
            border: 1px solid var(--brand);
            border-radius: 8px;
            padding: 0.5rem 1rem;
            font-weight: 600;
            font-size: 0.85rem;
            text-decoration: none;
        }
        .btn-track:hover { background: var(--pink-soft); color: var(--brand); }

        /* Footer */
        footer { background: #1a1a1a; color: #ddd; }
        footer a { color: #ddd; text-decoration: none; }
        footer a:hover { color: var(--brand); }
        footer h6 { font-weight: 600; margin-bottom: 1rem; color: #fff; }
        .footer-logo { height: 64px; }
        .footer-text { font-size: 0.85rem; color: #aaa; }
        footer ul { list-style: none; padding-left: 0; }
        footer ul li { margin-bottom: 0.5rem; font-size: 0.88rem; }
        .footer-divider { border-color: #333; }
        .social a {
            display: inline-flex;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #2a2a2a;
            align-items: center;
            justify-content: center;
            margin-right: 0.4rem;
            font-size: 0.78rem;
        }
        .social a:hover { background: var(--brand); color: #fff; }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar bg-white py-3 shadow-sm">
    <div class="container">
        <a class="navbar-brand" href="/">
            <img src="<%= images.logo %>" alt="FoodHub"
                 onerror="this.style.display='none';document.getElementById('brandText').style.display='inline';">
            <span id="brandText" style="display:none;">food<span class="brand-red">hub</span></span>
        </a>
        <a href="/menu" class="back-link">&larr; Back to menu</a>
    </div>
</nav>

<section class="container py-5">
    <h1 class="fw-bold mb-4" style="font-size: clamp(1.8rem, 4vw, 2.6rem);">My Orders</h1>

    <% if (orders.length === 0) { %>
        <div class="orders-empty">You have no orders yet.<br><a href="/menu">Browse the menu</a> to place your first order.</div>
    <% } else { %>
        <% orders.forEach(order => {
            const isCollected = order.status === 'collected';
            const isReady = !isCollected && Date.now() >= order.readyAt;
            const statusClass = isCollected ? 'status-collected' : (isReady ? 'status-ready' : 'status-preparing');
            const statusText = isCollected ? 'Collected' : (isReady ? 'Ready for Pickup' : 'Preparing');
        %>
            <div class="order-card">
                <div class="order-head">
                    <div>
                        <div class="order-id-text"><%= order.orderId %></div>
                        <div class="order-date"><%= new Date(order.createdAt).toLocaleDateString() %> <%= new Date(order.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></div>
                    </div>
                    <span class="status-badge <%= statusClass %>"><%= statusText %></span>
                </div>
                <% order.items.forEach(item => { %>
                <div class="order-line">
                    <span><%= item.name %> <span style="color:#7a7a7a;">&times; <%= item.qty %></span></span>
                    <span>$<%= (item.price * item.qty).toFixed(2) %></span>
                </div>
                <% }) %>
                <div class="order-total"><span>Total</span><span>$<%= order.total.toFixed(2) %></span></div>
                <div class="d-flex gap-2 mt-3">
                    <% if (!isCollected) { %>
                        <a href="/track/<%= order.orderId %>" class="btn-track">Track Order</a>
                    <% } %>
                    <button type="button" class="btn-reorder" onclick='reorderOrder(<%- JSON.stringify(order.items) %>)'>Reorder</button>
                </div>
            </div>
        <% }) %>
    <% } %>
</section>

<%- include('partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/cart.js"></script>
<script>
    function reorderOrder(items) {
        reorderItems(items);
        window.location.href = '/checkout';
    }
</script>

</body>
</html>
