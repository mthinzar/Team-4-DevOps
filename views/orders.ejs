<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodHub - My Orders</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --brand: #e23744;
            --brand-dark: #c52d39;
            --pink: #fcd7dd;
            --pink-soft: #ffeef1;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            color: #1a1a1a;
        }

        .brand-red { color: var(--brand); }

        .navbar-brand img { height: 64px; }
        .back-link { color: #6b4a4f; text-decoration: none; font-weight: 500; }
        .back-link:hover { color: var(--brand); }

        .order-card {
            background: #fff;
            border: 1px solid #f0d0d4;
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 1.25rem;
        }
        .order-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
        }
        .order-id-text { font-weight: 700; }
        .order-date { color: #7a7a7a; font-size: 0.85rem; }
        .order-line { display: flex; justify-content: space-between; font-size: 0.92rem; padding: 0.4rem 0; border-bottom: 1px solid #f0d0d4; }
        .order-line:last-of-type { border-bottom: none; }
        .order-total { display: flex; justify-content: space-between; font-weight: 700; padding-top: 0.75rem; }

        .status-badge { font-size: 0.75rem; font-weight: 700; border-radius: 999px; padding: 0.3rem 0.85rem; }
        .status-paid { background: var(--pink-soft); color: var(--brand); }
        .status-refunded { background: #eeeeee; color: #7a7a7a; }
        .status-cancelled { background: #eeeeee; color: #7a7a7a; }

        .orders-empty { text-align: center; color: #7a7a7a; padding: 4rem 1rem; }
        .orders-empty a { color: var(--brand); }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar bg-white py-3 shadow-sm">
    <div class="container">
        <a class="navbar-brand" href="/">
            <img src="<%= images.logo %>" alt="FoodHub"
                 onerror="this.style.display='none';document.getElementById('brandText').style.display='inline';">
            <span id="brandText" style="display:none;">food<span class="brand-red">hub</span></span>
        </a>
        <a href="/menu" class="back-link">&larr; Back to menu</a>
    </div>
</nav>

<section class="container py-5">
    <h1 class="fw-bold mb-4" style="font-size: clamp(1.8rem, 4vw, 2.6rem);">My Orders</h1>
    <div id="ordersList"></div>
</section>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/cart.js"></script>
<script>
    // Pick the badge colour based on the order status
    function statusClass(status) {
        if (status === 'Paid') return 'status-paid';
        if (status === 'Refunded') return 'status-refunded';
        return 'status-cancelled';
    }

    // Turn the saved date into something readable
    function formatDate(iso) {
        const d = new Date(iso);
        return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    // Build the order history from the orders saved in cart.js
    function renderOrders() {
        const orders = getOrders();
        const container = document.getElementById('ordersList');

        if (orders.length === 0) {
            container.innerHTML = '<div class="orders-empty">You have no orders yet.<br><a href="/menu">Browse the menu</a> to place your first order.</div>';
            return;
        }

        let html = '';
        orders.forEach(order => {
            let lines = '';
            order.items.forEach(item => {
                lines += `
                    <div class="order-line">
                        <span>${item.name} <span style="color:#7a7a7a;">&times; ${item.qty}</span></span>
                        <span>${formatPrice(item.price * item.qty)}</span>
                    </div>`;
            });

            html += `
                <div class="order-card">
                    <div class="order-head">
                        <div>
                            <div class="order-id-text">${order.id}</div>
                            <div class="order-date">${formatDate(order.date)}</div>
                        </div>
                        <span class="status-badge ${statusClass(order.status)}">${order.status}</span>
                    </div>
                    ${lines}
                    <div class="order-total"><span>Total</span><span>${formatPrice(order.total)}</span></div>
                </div>`;
        });

        container.innerHTML = html;
    }

    renderOrders();
</script>

</body>
</html>
