<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodHub - My Orders</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --brand: #e23744;
            --brand-dark: #c52d39;
            --pink: #fcd7dd;
            --pink-soft: #ffeef1;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            color: #1a1a1a;
        }

        .brand-red { color: var(--brand); }

        .navbar-brand img { height: 64px; }
        .back-link { color: #6b4a4f; text-decoration: none; font-weight: 500; }
        .back-link:hover { color: var(--brand); }

        .order-card {
            background: #fff;
            border: 1px solid #f0d0d4;
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 1.25rem;
        }
        .order-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
        }
        .order-id-text { font-weight: 700; }
        .order-date { color: #7a7a7a; font-size: 0.85rem; }
        .order-line { display: flex; justify-content: space-between; font-size: 0.92rem; padding: 0.4rem 0; border-bottom: 1px solid #f0d0d4; }
        .order-line:last-of-type { border-bottom: none; }
        .order-total { display: flex; justify-content: space-between; font-weight: 700; padding-top: 0.75rem; }

        .status-badge { font-size: 0.75rem; font-weight: 700; border-radius: 999px; padding: 0.3rem 0.85rem; }
        .status-preparing { background: var(--pink-soft); color: var(--brand); }
        .status-ready { background: #d1f5df; color: #198754; }
        .status-collected { background: #eeeeee; color: #7a7a7a; }
        .status-cancelled { background: #fde2e1; color: #c0392b; }

        .orders-empty { text-align: center; color: #7a7a7a; padding: 4rem 1rem; }
        .orders-empty a { color: var(--brand); }

        .btn-reorder {
            background: var(--brand);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 0.5rem 1rem;
            font-weight: 600;
            font-size: 0.85rem;
        }
        .btn-reorder:hover { background: var(--brand-dark); color: #fff; }

        .btn-track {
            background: #fff;
            color: var(--brand);
            border: 1px solid var(--brand);
            border-radius: 8px;
            padding: 0.5rem 1rem;
            font-weight: 600;
            font-size: 0.85rem;
            text-decoration: none;
        }
        .btn-track:hover { background: var(--pink-soft); color: var(--brand); }

        /* ---- Rate your dishes (collected orders only) ---- */
        .review-block {
            margin-top: 1rem;
            border-top: 1px dashed #f0d0d4;
            padding-top: 1rem;
        }
        .review-block-title { font-weight: 600; font-size: 0.92rem; margin-bottom: 0.75rem; }
        .review-row {
            display: flex;
            gap: 0.85rem;
            padding: 0.75rem 0;
            border-bottom: 1px solid #f7ecee;
        }
        .review-row:last-child { border-bottom: none; }
        .review-row img {
            width: 54px; height: 54px; object-fit: cover;
            border-radius: 10px; flex-shrink: 0; background: var(--pink-soft);
        }
        .review-row .rr-body { flex-grow: 1; min-width: 0; }
        .review-row .rr-name { font-weight: 600; font-size: 0.9rem; margin-bottom: 0.2rem; }

        .star-picker { display: inline-flex; gap: 0.15rem; cursor: pointer; user-select: none; }
        .star-picker .star {
            font-size: 1.25rem; line-height: 1; color: #dcdcdc; transition: color 0.12s;
        }
        .star-picker .star.on { color: #f5a623; }

        .rr-comment {
            width: 100%; margin-top: 0.5rem; border: 1px solid #f0d0d4;
            border-radius: 9px; padding: 0.45rem 0.65rem; font-size: 0.84rem;
            font-family: inherit; resize: vertical; min-height: 42px;
        }
        .rr-comment:focus { outline: none; border-color: var(--brand); }

        .rr-actions { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.45rem; }
        .btn-save-review {
            background: var(--brand); color: #fff; border: none; border-radius: 8px;
            padding: 0.35rem 0.9rem; font-weight: 600; font-size: 0.8rem;
        }
        .btn-save-review:hover:not(:disabled) { background: var(--brand-dark); }
        .btn-save-review:disabled { opacity: 0.55; }
        .rr-status { font-size: 0.78rem; }
        .rr-status.ok { color: #198754; }
        .rr-status.err { color: var(--brand); }
        .rr-existing { font-size: 0.72rem; color: #7a7a7a; }

        /* Footer */
        footer { background: #1a1a1a; color: #ddd; }
        footer a { color: #ddd; text-decoration: none; }
        footer a:hover { color: var(--brand); }
        footer h6 { font-weight: 600; margin-bottom: 1rem; color: #fff; }
        .footer-logo { height: 64px; }
        .footer-text { font-size: 0.85rem; color: #aaa; }
        footer ul { list-style: none; padding-left: 0; }
        footer ul li { margin-bottom: 0.5rem; font-size: 0.88rem; }
        .footer-divider { border-color: #333; }
        .social a {
            display: inline-flex;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #2a2a2a;
            align-items: center;
            justify-content: center;
            margin-right: 0.4rem;
            font-size: 0.78rem;
        }
        .social a:hover { background: var(--brand); color: #fff; }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="navbar bg-white py-3 shadow-sm">
    <div class="container">
        <a class="navbar-brand" href="/">
            <img src="<%= images.logo %>" alt="FoodHub"
                 onerror="this.style.display='none';document.getElementById('brandText').style.display='inline';">
            <span id="brandText" style="display:none;">food<span class="brand-red">hub</span></span>
        </a>
        <a href="/menu" class="back-link">&larr; Back to menu</a>
    </div>
</nav>

<section class="container py-5">
    <h1 class="fw-bold mb-4" style="font-size: clamp(1.8rem, 4vw, 2.6rem);">My Orders</h1>

    <% if (orders.length === 0) { %>
        <div class="orders-empty">You have no orders yet.<br><a href="/menu">Browse the menu</a> to place your first order.</div>
    <% } else { %>
        <% orders.forEach(order => {
            const isDone = order.status === 'completed' || order.status === 'collected';
            const isCancelled = order.status === 'cancelled';
            const isReady = order.status === 'ready';
            let statusClass = 'status-preparing';
            let statusText = 'Preparing';
            if (isCancelled) { statusClass = 'status-cancelled'; statusText = 'Cancelled'; }
            else if (isDone) { statusClass = 'status-collected'; statusText = 'Collected'; }
            else if (isReady) { statusClass = 'status-ready'; statusText = 'Ready for Pickup'; }
            else if (order.status === 'pending') { statusText = 'Order Received'; }
        %>
            <div class="order-card">
                <div class="order-head">
                    <div>
                        <div class="order-id-text"><%= order.orderId %></div>
                        <div class="order-date"><%= new Date(order.createdAt).toLocaleDateString() %> <%= new Date(order.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></div>
                    </div>
                    <span class="status-badge <%= statusClass %>"><%= statusText %></span>
                </div>
                <% order.items.forEach(item => { %>
                <div class="order-line">
                    <span><%= item.name %> <span style="color:#7a7a7a;">&times; <%= item.qty %></span></span>
                    <span>$<%= (item.price * item.qty).toFixed(2) %></span>
                </div>
                <% }) %>
                <div class="order-total"><span>Total</span><span>$<%= order.total.toFixed(2) %></span></div>
                <div class="d-flex gap-2 mt-3">
                    <% if (!isDone && !isCancelled) { %>
                        <a href="/track/<%= order.orderId %>" class="btn-track">Track Order</a>
                    <% } %>
                    <button type="button" class="btn-reorder" onclick='reorderOrder(<%- JSON.stringify(order.items) %>)'>Reorder</button>
                </div>

                <%
                    // Rating is only offered once an order has actually been collected —
                    // the same rule the server enforces on POST.
                    const reviewable = isDone && !isCancelled
                        ? order.items.filter(item => item.foodId)
                        : [];
                %>
                <% if (reviewable.length > 0) { %>
                    <div class="review-block">
                        <div class="review-block-title">⭐ Rate your dishes</div>

                        <% reviewable.forEach(item => {
                            const existing = reviewByFood[item.foodId] || null;
                        %>
                            <div class="review-row" data-foodid="<%= item.foodId %>">
                                <% if (item.image) { %>
                                    <img src="<%= item.image %>" alt="<%= item.name %>">
                                <% } %>
                                <div class="rr-body">
                                    <div class="rr-name">
                                        <%= item.name %>
                                        <% if (existing) { %>
                                            <span class="rr-existing">— you rated this <%= existing.rating %>/5</span>
                                        <% } %>
                                    </div>

                                    <div class="star-picker" data-rating="<%= existing ? existing.rating : 0 %>">
                                        <% for (let s = 1; s <= 5; s++) { %>
                                            <span class="star <%= existing && existing.rating >= s ? 'on' : '' %>" data-value="<%= s %>">★</span>
                                        <% } %>
                                    </div>

                                    <textarea class="rr-comment" rows="1" maxlength="500"
                                              placeholder="Anything you'd tell another student about this dish? (optional)"><%= existing ? existing.comment : '' %></textarea>

                                    <div class="rr-actions">
                                        <button type="button" class="btn-save-review">
                                            <%= existing ? 'Update review' : 'Post review' %>
                                        </button>
                                        <span class="rr-status"></span>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        <% }) %>
    <% } %>
</section>

<%- include('partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/cart.js"></script>
<script>
    function reorderOrder(items) {
        reorderItems(items);
        window.location.href = '/checkout';
    }

    // ---- Rate your dishes ----

    function paintStars(picker, value) {
        picker.querySelectorAll('.star').forEach(star => {
            star.classList.toggle('on', Number(star.dataset.value) <= value);
        });
    }

    document.querySelectorAll('.star-picker').forEach(picker => {
        // Preview on hover, commit on click.
        picker.addEventListener('mouseover', event => {
            const star = event.target.closest('.star');
            if (star) paintStars(picker, Number(star.dataset.value));
        });
        picker.addEventListener('mouseleave', () => {
            paintStars(picker, Number(picker.dataset.rating) || 0);
        });
        picker.addEventListener('click', event => {
            const star = event.target.closest('.star');
            if (!star) return;
            picker.dataset.rating = star.dataset.value;
            paintStars(picker, Number(star.dataset.value));
        });
    });

    document.querySelectorAll('.btn-save-review').forEach(button => {
        button.addEventListener('click', function () {
            const row = this.closest('.review-row');
            const picker = row.querySelector('.star-picker');
            const status = row.querySelector('.rr-status');
            const rating = Number(picker.dataset.rating) || 0;

            if (rating < 1) {
                status.className = 'rr-status err';
                status.textContent = 'Pick a star rating first.';
                return;
            }

            this.disabled = true;
            status.className = 'rr-status';
            status.textContent = 'Saving…';

            fetch(`/api/foods/${row.dataset.foodid}/reviews`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ rating: rating, comment: row.querySelector('.rr-comment').value })
            })
            .then(response => response.json())
            .then(result => {
                this.disabled = false;
                if (!result.success) {
                    status.className = 'rr-status err';
                    status.textContent = result.message || 'Could not save your review.';
                    return;
                }
                status.className = 'rr-status ok';
                status.textContent = '✓ Thanks for rating!';
                this.textContent = 'Update review';
            })
            .catch(() => {
                this.disabled = false;
                status.className = 'rr-status err';
                status.textContent = 'Could not reach the server.';
            });
        });
    });
</script>

</body>
</html>
