    <!-- Auth: phone + real server-verified security code, session-backed -->
    <script>
    (function () {
        let currentUser = <%- JSON.stringify(user) %>;

        function renderAuth() {
            window.currentUser = currentUser;
            const authButtons = document.getElementById('authButtons');
            const userMenu = document.getElementById('userMenu');
            if (currentUser && currentUser.name) {
                authButtons.classList.add('d-none');
                userMenu.classList.remove('d-none');
                document.getElementById('userName').textContent = currentUser.name;
                document.getElementById('userInitial').textContent = currentUser.name.trim().charAt(0).toUpperCase();
            } else {
                authButtons.classList.remove('d-none');
                userMenu.classList.add('d-none');
            }
        }

        document.getElementById('logoutBtn').addEventListener('click', function (e) {
            e.preventDefault();
            fetch('/auth/logout', { method: 'POST' }).then(() => {
                currentUser = null;
                renderAuth();
            });
        });

        function closeModal(id) {
            const inst = bootstrap.Modal.getInstance(document.getElementById(id));
            if (inst) inst.hide();
        }

        function showStep(prefix, step) {
            document.getElementById(prefix + 'Step1').style.display = step === 1 ? 'block' : 'none';
            document.getElementById(prefix + 'Step2').style.display = step === 2 ? 'block' : 'none';
        }

        const cleanPhone = v => v.replace(/\s+/g, '');
        const validPhone = v => /^[689]\d{7}$/.test(cleanPhone(v));
        const validCode  = v => /^\d{6}$/.test(v.replace(/\s+/g, ''));

        function setupOtp(prefix, opts) {
            const phone = document.getElementById(prefix + 'Phone');
            const code  = document.getElementById(prefix + 'Code');

            document.getElementById(prefix + 'SendBtn').addEventListener('click', function () {
                if (opts.requireName) {
                    const name = document.getElementById(prefix + 'Name');
                    if (!name.value.trim()) {
                        document.getElementById(prefix + 'NameErr').style.display = 'block';
                        return;
                    }
                    document.getElementById(prefix + 'NameErr').style.display = 'none';
                }
                if (!validPhone(phone.value)) {
                    document.getElementById(prefix + 'PhoneErr').style.display = 'block';
                    return;
                }
                document.getElementById(prefix + 'PhoneErr').style.display = 'none';

                const body = { phone: cleanPhone(phone.value) };
                if (opts.requireName) body.name = document.getElementById(prefix + 'Name').value.trim();

                fetch('/auth/send-code', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                })
                .then(r => r.json())
                .then(result => {
                    if (!result.success) {
                        const err = document.getElementById(prefix + 'PhoneErr');
                        err.textContent = result.message;
                        err.style.display = 'block';
                        return;
                    }
                    document.getElementById(prefix + 'SentTo').textContent = '+65 ' + cleanPhone(phone.value);
                    document.getElementById(prefix + 'DevCode').textContent = result.devCode;
                    showStep(prefix, 2);
                    code.value = '';
                    code.focus();
                });
            });

            document.getElementById(prefix + 'VerifyBtn').addEventListener('click', function () {
                if (!validCode(code.value)) {
                    document.getElementById(prefix + 'CodeErr').style.display = 'block';
                    return;
                }
                document.getElementById(prefix + 'CodeErr').style.display = 'none';

                const body = { phone: cleanPhone(phone.value), code: code.value.trim() };
                if (opts.requireName) body.name = document.getElementById(prefix + 'Name').value.trim();

                fetch('/auth/verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                })
                .then(r => r.json())
                .then(result => {
                    if (!result.success) {
                        const err = document.getElementById(prefix + 'CodeErr');
                        err.textContent = result.message;
                        err.style.display = 'block';
                        return;
                    }
                    currentUser = { name: result.name };
                    renderAuth();
                    closeModal(prefix + 'Modal');
                    showStep(prefix, 1);
                });
            });

            document.getElementById(prefix + 'Resend').addEventListener('click', function () {
                showStep(prefix, 1);
            });
        }

        setupOtp('login', { requireName: false });
        setupOtp('signup', { requireName: true });

        renderAuth();
    })();
    </script>

    <!-- Customer / Merchant role tabs + merchant login & signup -->
    <script>
    (function () {
        function showPane(modal, role) {
            document.getElementById(`${modal}CustomerPane`).style.display = role === 'customer' ? 'block' : 'none';
            document.getElementById(`${modal}MerchantPane`).style.display = role === 'merchant' ? 'block' : 'none';
        }

        function selectRole(modal, role) {
            const group = document.querySelector(`.role-tabs[data-modal="${modal}"]`);
            if (!group) return;
            group.querySelectorAll('.role-tab').forEach(t => t.classList.toggle('active', t.dataset.role === role));
            showPane(modal, role);
            if (role === 'merchant' && modal === 'signup') loadAvailableStalls();
        }

        document.querySelectorAll('.role-tab').forEach(tab => {
            tab.addEventListener('click', function () {
                selectRole(this.closest('.role-tabs').dataset.modal, this.dataset.role);
            });
        });

        document.querySelectorAll('[data-preselect-role]').forEach(link => {
            link.addEventListener('click', () => {
                setTimeout(() => {
                    selectRole('login', link.dataset.preselectRole);
                    selectRole('signup', link.dataset.preselectRole);
                }, 150);
            });
        });

        let stallsLoaded = false;
        function loadAvailableStalls() {
            if (stallsLoaded) return;
            const select = document.getElementById('merchantStallSelect');
            fetch('/api/merchant/available-stalls')
                .then(r => r.json())
                .then(data => {
                    stallsLoaded = true;
                    let html = '<option value="">Select a stall…</option>';
                    (data.stalls || []).forEach(s => {
                        html += `<option value="${s.id}">${s.emoji || ''} ${s.name}</option>`;
                    });
                    html += '<option value="__new__">+ Create a New Stall</option>';
                    select.innerHTML = html;
                })
                .catch(() => {
                    select.innerHTML = '<option value="">Could not load stalls</option><option value="__new__">+ Create a New Stall</option>';
                });
        }

        document.getElementById('merchantStallSelect').addEventListener('change', function () {
            document.getElementById('newStallFields').style.display = this.value === '__new__' ? 'block' : 'none';
        });

        document.getElementById('merchantLoginBtn').addEventListener('click', function () {
            const email = document.getElementById('merchantLoginEmail').value.trim();
            const password = document.getElementById('merchantLoginPassword').value;
            const errEl = document.getElementById('merchantLoginError');
            errEl.style.display = 'none';

            this.disabled = true;
            fetch('/merchant/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            })
            .then(r => r.json())
            .then(result => {
                this.disabled = false;
                if (!result.success) {
                    errEl.textContent = result.message || 'Could not log in.';
                    errEl.style.display = 'block';
                    return;
                }
                window.location.href = result.status === 'approved' ? '/merchant/dashboard' : '/merchant/pending';
            })
            .catch(() => {
                this.disabled = false;
                errEl.textContent = 'Could not reach the server. Please try again.';
                errEl.style.display = 'block';
            });
        });

        document.getElementById('merchantSignupBtn').addEventListener('click', function () {
            const errEl = document.getElementById('merchantSignupError');
            errEl.style.display = 'none';

            const stallChoice = document.getElementById('merchantStallSelect').value;
            if (!stallChoice) {
                errEl.textContent = 'Please choose a stall to manage.';
                errEl.style.display = 'block';
                return;
            }

            const formData = new FormData();
            formData.append('email', document.getElementById('merchantSignupEmail').value.trim());
            formData.append('password', document.getElementById('merchantSignupPassword').value);
            formData.append('confirmPassword', document.getElementById('merchantSignupConfirmPassword').value);

            if (stallChoice === '__new__') {
                formData.append('stallMode', 'new');
                formData.append('newStallName', document.getElementById('newStallName').value.trim());
                const imgFile = document.getElementById('newStallImage').files[0];
                if (imgFile) formData.append('stallImage', imgFile);
            } else {
                formData.append('stallMode', 'existing');
                formData.append('stallId', stallChoice);
            }

            this.disabled = true;
            fetch('/merchant/signup', { method: 'POST', body: formData })
                .then(r => r.json())
                .then(result => {
                    this.disabled = false;
                    if (!result.success) {
                        errEl.textContent = result.message || 'Could not create your account.';
                        errEl.style.display = 'block';
                        return;
                    }
                    window.location.href = result.status === 'approved' ? '/merchant/dashboard' : '/merchant/pending';
                })
                .catch(() => {
                    this.disabled = false;
                    errEl.textContent = 'Could not reach the server. Please try again.';
                    errEl.style.display = 'block';
                });
        });
    })();
    </script>

