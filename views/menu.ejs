<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FoodHub - Stalls</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --brand: #e23744;
            --brand-dark: #c52d39;
            --pink: #fcd7dd;
            --pink-soft: #ffeef1;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #fcf9fa;
            color: #1a1a1a;
        }

        .brand-red {
            color: var(--brand);
        }

        /* Navbar Sticky & Translucent */
        .navbar {
            backdrop-filter: blur(12px);
            background-color: rgba(255, 255, 255, 0.9) !important;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(226, 55, 68, 0.08);
        }

        .navbar-brand img {
            height: 56px;
        }

        .nav-link-custom {
            color: #1a1a1a;
            font-weight: 500;
            margin: 0 1rem;
            text-decoration: none;
            position: relative;
        }

        .nav-link-custom::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: -6px;
            width: 0;
            height: 2px;
            background: var(--brand);
            transition: 0.25s;
        }

        .nav-link-custom:hover {
            color: var(--brand);
        }

        .nav-link-custom:hover::after {
            width: 100%;
        }

        .btn-login {
            border: 1px solid var(--brand);
            color: var(--brand);
            background: #fff;
            border-radius: 8px;
        }

        .btn-login:hover {
            background: var(--brand);
            color: #fff;
        }

        .btn-signup {
            background: var(--brand);
            color: #fff;
            border: 1px solid var(--brand);
            border-radius: 8px;
        }

        .btn-signup:hover {
            background: var(--brand-dark);
            color: #fff;
        }

        /* Logged-in user menu */
        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--brand);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.95rem;
        }
        .btn-user {
            border: 1px solid #f0d0d4;
            background: #fff;
            border-radius: 30px;
            padding: 0.25rem 0.75rem 0.25rem 0.35rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 500;
        }
        .btn-user:hover { background: var(--pink-soft); }

        /* Search Header Section */
        .search-header {
            background: linear-gradient(120deg, #fde2e7 0%, #fcd7dd 100%);
            padding: 3rem 0;
            border-radius: 0 0 32px 32px;
            box-shadow: 0 8px 30px rgba(226, 55, 68, 0.05);
        }

        .menu-search {
            position: relative;
            max-width: 600px;
            margin: 0 auto;
        }

        .menu-search input {
            border: 1px solid #f0d0d4;
            padding: 0.85rem 1.5rem;
            border-radius: 30px;
            font-size: 1rem;
            box-shadow: 0 6px 20px rgba(226, 55, 68, 0.06);
            transition: 0.3s;
        }

        .menu-search input:focus {
            border-color: var(--brand);
            box-shadow: 0 6px 24px rgba(226, 55, 68, 0.15);
            outline: none;
        }

        /* Stall Cards Directory */
        .stall-card {
            background: #fff;
            border: 1px solid #f0d0d4;
            border-radius: 20px;
            padding: 2rem 1.5rem;
            text-align: center;
            cursor: pointer;
            transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), box-shadow 0.3s, border-color 0.3s;
            height: 100%;
            position: relative;
        }
        .stall-card.is-closed { opacity: 0.65; }
        .closed-ribbon {
            position: absolute;
            top: 12px;
            right: 12px;
            background: #842029;
            color: #fff;
            font-size: 0.68rem;
            font-weight: 700;
            text-transform: uppercase;
            padding: 0.25rem 0.6rem;
            border-radius: 6px;
        }
        .stall-closed-banner {
            background: #f8d7da;
            color: #842029;
            border-radius: 12px;
            padding: 0.9rem 1.1rem;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 1.25rem;
        }
        .sold-out-ribbon-menu {
            position: absolute;
            top: 10px;
            left: 10px;
            background: #842029;
            color: #fff;
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            padding: 0.2rem 0.55rem;
            border-radius: 6px;
            z-index: 2;
        }
        .dish-card.is-unavailable { opacity: 0.6; cursor: not-allowed; }

        .stall-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 24px rgba(226, 55, 68, 0.1);
            border-color: var(--brand);
        }

        .stall-emoji {
            font-size: 2.8rem;
            margin-bottom: 1rem;
            display: inline-block;
        }

        .stall-name {
            font-weight: 700;
            font-size: 1.15rem;
            color: #1a1a1a;
        }

        .stall-desc {
            font-size: 0.85rem;
            color: #7a7a7a;
            margin-top: 0.5rem;
            margin-bottom: 0;
        }

        /* Food items layout */
        .dish-card {
            border: 1px solid #f0d0d4;
            border-radius: 16px 16px 40px 40px;
            text-align: center;
            transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), box-shadow 0.3s ease, border-color 0.3s ease;
            background: #fff;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
            cursor: pointer;
        }

        .dish-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 14px 28px rgba(226, 55, 68, 0.12);
            border-color: var(--brand);
        }

        .dish-img-wrap {
            background: var(--pink-soft);
            padding: 1.25rem 0 0.75rem;
            border-radius: 0 0 50% 50%;
            position: relative;
        }

        .dish-img {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid #fff;
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.1);
        }

        .dish-name {
            font-weight: 600;
            font-size: 1rem;
            margin-top: 0.75rem;
        }

        .dish-desc {
            font-size: 0.78rem;
            color: #7a7a7a;
            padding: 0 0.9rem;
            margin-bottom: 0.75rem;
            flex-grow: 1;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .dish-price {
            color: var(--brand);
            font-weight: 700;
            font-size: 1.1rem;
        }

        .dish-rating {
            font-size: 0.78rem;
            color: #7a7a7a;
            margin-bottom: 0.35rem;
        }

        .stars-sm { color: #f5a623; }

        /* Choice options styling in Customize Modal */
        .opt-radio-card {
            border: 1px solid rgba(226, 55, 68, 0.15);
            border-radius: 12px;
            padding: 0.65rem 0.9rem;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: background 0.2s, border-color 0.2s;
            background: #fff;
            margin-bottom: 0.5rem;
        }

        .opt-radio-card:hover {
            background: var(--pink-soft);
        }

        .opt-radio-card input:checked + span {
            font-weight: 600;
        }

        .opt-radio-card.active {
            border-color: var(--brand);
            background: var(--pink-soft);
        }

        .spicy-btn-pill {
            transition: 0.2s;
        }

        /* Cart button + badge */
        .btn-cart {
            border: 1px solid var(--brand);
            background: #fff;
            border-radius: 8px;
            font-size: 1.1rem;
            line-height: 1;
            padding: 0.4rem 0.75rem;
            position: relative;
        }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -8px;
            background: var(--brand);
            color: #fff;
            font-size: 0.68rem;
            font-weight: 700;
            min-width: 18px;
            height: 18px;
            border-radius: 50%;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
        }

        /* Cart Drawer List */
        .cart-item {
            display: flex;
            gap: 0.75rem;
            align-items: flex-start;
            padding: 0.9rem 0;
            border-bottom: 1px solid #f0d0d4;
        }

        .cart-item img {
            width: 52px;
            height: 52px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #f0d0d4;
        }

        .cart-item-name {
            font-weight: 600;
            font-size: 0.9rem;
            line-height: 1.2;
        }

        .cart-item-price {
            color: var(--brand);
            font-weight: 700;
            font-size: 0.88rem;
        }

        .qty-box {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            margin-top: 0.25rem;
        }

        .qty-box button {
            border: 1px solid #e0a4ac;
            background: #fff;
            width: 24px;
            height: 24px;
            border-radius: 6px;
            line-height: 1;
            font-weight: 700;
            color: #1a1a1a;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .qty-box button:hover {
            background: var(--pink-soft);
        }

        .cart-remove {
            background: none;
            border: none;
            color: #888;
            font-size: 0.75rem;
        }

        .cart-remove:hover {
            color: var(--brand);
            text-decoration: underline;
        }

        .cart-empty {
            text-align: center;
            color: #888;
            padding: 4rem 1rem;
        }

        .cart-footer {
            border-top: 1px solid #f0d0d4;
            padding-top: 1rem;
            margin-top: 0.5rem;
        }

        /* Top Center Toast Banner Alert */
        .cart-toast {
            position: fixed;
            top: 24px;
            left: 50%;
            transform: translate(-50%, -180%);
            z-index: 2000;
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(8px);
            color: #1a1a1a;
            border-left: 5px solid var(--brand);
            padding: 1rem 2.2rem;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(226, 55, 68, 0.15);
            display: flex;
            align-items: center;
            gap: 0.8rem;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            font-weight: 600;
            font-size: 1.05rem;
            pointer-events: none;
            min-width: 340px;
            justify-content: center;
        }

        .cart-toast.show {
            transform: translate(-50%, 0);
        }

        /* Auth Modals */
        .auth-modal .modal-content {
            border: none;
            border-radius: 18px;
            overflow: hidden;
        }

        .auth-header {
            background: linear-gradient(120deg, #fde2e7 0%, #f9c4cd 100%);
            text-align: center;
            padding: 1.75rem 1.5rem 1.25rem;
            position: relative;
        }

        .auth-header img {
            height: 56px;
        }

        .auth-header h5 {
            font-weight: 700;
            margin-top: 0.75rem;
            margin-bottom: 0;
        }

        .auth-header p {
            font-size: 0.85rem;
            color: #6b4a4f;
            margin: 0;
        }

        .auth-body {
            padding: 1.5rem;
        }

        .auth-body .form-label {
            font-weight: 500;
            font-size: 0.85rem;
        }

        .auth-body .form-control {
            border-radius: 10px;
            padding: 0.6rem 0.9rem;
        }
        .code-hint { font-size: 0.8rem; color: #7a7a7a; }
        .auth-body .input-group-text {
            background: var(--pink-soft);
            border-color: #dee2e6;
            font-weight: 600;
            color: #1a1a1a;
        }
        .field-err { display: none; color: var(--brand); font-size: 0.78rem; margin-top: 0.3rem; }

        .btn-auth {
            background: var(--brand);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 0.65rem;
            font-weight: 600;
            width: 100%;
        }
        .btn-link-brand {
            background: none;
            border: none;
            color: var(--brand);
            font-size: 0.82rem;
            font-weight: 500;
            padding: 0;
        }
        .btn-link-brand:hover { text-decoration: underline; }
        .auth-switch { font-size: 0.85rem; text-align: center; margin-top: 1rem; }
        .auth-switch a { color: var(--brand); text-decoration: none; font-weight: 600; cursor: pointer; }
        .auth-switch a:hover { text-decoration: underline; }

        /* Customer / Merchant role tabs inside login & signup modals */
        .role-tabs {
            display: flex;
            gap: 0.5rem;
            background: var(--pink-soft);
            border-radius: 12px;
            padding: 0.3rem;
            margin-bottom: 1.25rem;
        }
        .role-tab {
            flex: 1;
            background: none;
            border: none;
            border-radius: 9px;
            padding: 0.5rem 0.5rem;
            font-weight: 600;
            font-size: 0.88rem;
            color: #6b4a4f;
            transition: 0.2s;
        }
        .role-tab.active {
            background: #fff;
            color: var(--brand);
            box-shadow: 0 2px 6px rgba(226,55,68,0.15);
        }

        footer {
            background: #1a1a1a;
            color: #ddd;
        }
        footer a { color: #ddd; text-decoration: none; }
        footer a:hover { color: var(--brand); }
        footer h6 { font-weight: 600; margin-bottom: 1rem; color: #fff; }
        .footer-logo { height: 64px; }
        .footer-text { font-size: 0.85rem; color: #aaa; }
        footer ul { list-style: none; padding-left: 0; }
        footer ul li { margin-bottom: 0.5rem; font-size: 0.88rem; }
        .footer-divider { border-color: #333; }
        .social a {
            display: inline-flex;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: #2a2a2a;
            align-items: center;
            justify-content: center;
            margin-right: 0.4rem;
            font-size: 0.78rem;
        }
        .social a:hover { background: var(--brand); color: #fff; }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg py-2 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold fs-3" href="/">
                <img src="<%= images.logo %>" alt="FoodHub"
                    onerror="this.style.display='none';document.getElementById('brandText').style.display='inline';">
                <span id="brandText" style="display:none;">food<span class="brand-red">hub</span></span>
            </a>

            <div class="d-none d-lg-flex flex-grow-1 justify-content-center">
                <a href="/" class="nav-link-custom">Home</a>
                <a href="/menu" class="nav-link-custom active">Stalls</a>
            </div>

            <div class="d-flex align-items-center">
                <button type="button" class="btn btn-cart position-relative me-2" id="cartButton"
                    aria-label="Open cart">
                    🛒<span class="cart-badge" id="cartBadge">0</span>
                </button>

                <!-- Logged-out: Login / Sign Up -->
                <div id="authButtons" class="d-flex">
                    <button type="button" class="btn btn-login me-2" data-bs-toggle="modal" data-bs-target="#loginModal">Login</button>
                    <button type="button" class="btn btn-signup" data-bs-toggle="modal" data-bs-target="#signupModal">Sign Up</button>
                </div>

                <!-- Logged-in: avatar + name dropdown -->
                <div id="userMenu" class="dropdown d-none">
                    <button class="btn btn-user dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="user-avatar" id="userInitial">U</span>
                        <span id="userName">User</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li><a class="dropdown-item" href="/orders">My Orders</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#" id="logoutBtn">Logout</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Shortcut back to the live tracker for an order still in progress -->
    <div class="container">
        <div class="d-flex justify-content-end">
            <a href="#" id="navTrackLink" class="btn btn-sm mt-2" style="display:none; background:#d1f5df; color:#198754; border-radius:20px; font-weight:600; font-size:0.8rem;">
                🍳 Track order <span id="navTrackQueue"></span> &rarr;
            </a>
        </div>
    </div>

    <!-- Search Section -->
    <header class="search-header text-center">
        <div class="container">
            <h1 class="fw-bold mb-3">What are you craving today?</h1>
            <div class="menu-search">
                <input type="text" id="searchInput" class="form-control"
                    placeholder="Search stalls (e.g. Western Stall, Malay Stall, Dessert Stall)...">
            </div>
        </div>
    </header>

    <!-- Stalls Directory Grid -->
    <section class="container py-5" id="stallDirectory">
        <div class="row g-4">
            <% stalls.forEach(stall=> { %>
                <div class="col-12 col-sm-6 col-md-4 stall-column" data-stall-name="<%= stall.name.toLowerCase() %>">
                    <div class="stall-card <%= stall.isOpen === false ? 'is-closed' : '' %>" onclick="openStall('<%= stall.id %>')">
                        <% if (stall.isOpen === false) { %><span class="closed-ribbon">Closed</span><% } %>
                        <% if (stall.image) { %>
                            <div class="stall-img-wrap mb-3">
                                <img src="<%= stall.image %>" alt="<%= stall.name %>" class="img-fluid rounded-4" style="height: 200px; object-fit: cover; width: 100%;">
                            </div>
                        <% } else { %>
                            <span class="stall-emoji">
                                <%= stall.emoji %>
                            </span>
                        <% } %>
                        <div class="stall-name">
                            <%= stall.name %>
                        </div>
                        <p class="stall-desc">
                            <%= stall.description %>
                        </p>
                    </div>
                </div>
            <% }) %>
        </div>
        <div id="noResultsBlock" class="text-center py-5 text-muted" style="display: none;">
            <span style="font-size: 3rem;">🔍</span>
            <h5 class="mt-3 fw-bold">No stalls match your search</h5>
            <p class="small">Try a different stall name or clear the search field.</p>
        </div>
    </section>

    <!-- Stall Menu Grid -->
    <section class="container py-5" id="stallMenu" style="display: none;">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <button class="btn btn-outline-dark px-3 py-1.5 rounded-3 fw-medium" onclick="goBackToStalls()">← Back to Stalls</button>
            <h4 class="fw-bold mb-0" id="currentStallTitle">Menu</h4>
        </div>

        <div class="stall-closed-banner" id="stallClosedBanner" style="display:none;">
            🔒 This stall is currently closed for new orders. You can browse the menu, but ordering is disabled until it reopens.
        </div>

        <div class="row g-4" id="menuGrid">
            <% stalls.forEach(stall=> { %>
                <% stall.foods.forEach(food=> { %>
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3 menu-item stall-group-<%= stall.id %>"
                        data-name="<%= food.name.toLowerCase() %>">
                        <div class="dish-card <%= food.soldOut ? 'is-unavailable' : '' %>"
                            data-foodid="<%= food.id %>"
                            data-name="<%= food.name %>"
                            data-price="<%= food.price %>"
                            data-image="<%= food.image %>"
                            data-stall="<%= stall.name %>"
                            data-stall-id="<%= stall.id %>"
                            data-sold-out="<%= food.soldOut ? '1' : '' %>"
                            data-options='<%= JSON.stringify(food.options || null) %>'>
                            <% if (food.soldOut) { %><span class="sold-out-ribbon-menu">Sold Out</span><% } %>
                            <div class="dish-img-wrap">
                                <img src="<%= food.image %>" class="dish-img" alt="<%= food.name %>"
                                    onerror="this.src='https://img.icons8.com/color/96/hamburger.png';">
                            </div>

                            <div class="dish-info-panel text-center">
                                <div class="dish-name">
                                    <%= food.name %>
                                    <% if (food.badge) { %>
                                        <span class="badge bg-danger ms-1 text-uppercase" style="font-size:0.6rem;">
                                            <%= food.badge %>
                                        </span>
                                    <% } %>
                                </div>
                                <div class="dish-rating">
                                    <% if (food.reviewCount > 0) { %>
                                        <span class="stars-sm">★</span> <%= food.avgRating.toFixed(1) %>
                                        <span class="text-muted">(<%= food.reviewCount %>)</span>
                                    <% } else { %>
                                        <span class="text-muted">No reviews yet</span>
                                    <% } %>
                                </div>
                                <div class="d-flex flex-column align-items-center justify-content-center mt-auto">
                                    <div class="dish-price mb-3">$<%= food.price.toFixed(2) %></div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% }) %>
        </div>
    </section>

    <%- include('partials/footer') %>

    <!-- Customize Item Modal -->
    <div class="modal fade" id="customizeModal" tabindex="-1" aria-labelledby="customizeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 overflow-hidden shadow-lg">

                <div class="position-relative">
                    <button type="button" class="btn-close position-absolute top-0 start-0 m-3 shadow-none bg-white rounded-circle p-2" data-bs-dismiss="modal" aria-label="Close" style="z-index: 10;"></button>
                    <img id="modalFoodImg" src="" alt="" class="w-100" style="height: 160px; object-fit: cover;">
                </div>

                <div class="modal-header border-0 bg-white p-4 pb-0 d-flex justify-content-between align-items-start">
                    <div>
                        <h4 class="modal-title fw-bold" id="customizeModalLabel">Customize Item</h4>
                        <div class="text-muted small" id="modalFoodStall">Stall Name</div>
                    </div>
                    <h5 class="fw-bold mb-0" id="modalBasePrice">$0.00</h5>
                </div>

                <div class="modal-body p-4">
                    <form id="customizeForm">
                        <input type="hidden" id="modalFoodName">

                        <div class="mb-4 d-none" id="sizeGroup">
