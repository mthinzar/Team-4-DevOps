<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - FoodHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%- include('../partials/admin-styles') %>
    <style>
        .feedback-row { padding: 0.6rem 0; border-bottom: 1px solid var(--a-border); }
        .feedback-row:last-child { border-bottom: none; }
        .feedback-stars { color: var(--a-accent); letter-spacing: 1px; font-size: 0.85rem; }
    </style>
</head>
<body class="admin-body">

<%- include('../partials/admin-nav', { activePage: 'dashboard' }) %>

<div class="container-fluid px-3 px-md-4 py-4">
    <h1 class="a-page-title mb-1">Platform Overview</h1>
    <p class="a-page-sub mb-4">Summary across every store on FoodHub.</p>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-2">
            <div class="a-stat-card"><div class="label">Total Stores</div><div class="value"><%= stats.totalStores %></div></div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="a-stat-card"><div class="label">Total Customers</div><div class="value"><%= stats.totalCustomers %></div></div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="a-stat-card"><div class="label">Total Orders</div><div class="value"><%= stats.totalOrders %></div></div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="a-stat-card"><div class="label">Orders Today</div><div class="value"><%= stats.ordersTodayCount %></div></div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="a-stat-card"><div class="label">Total Sales</div><div class="value">$<%= stats.totalSales.toFixed(2) %></div></div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="a-stat-card"><div class="label">Platform Revenue</div><div class="value">$<%= stats.totalRevenue.toFixed(2) %></div></div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="a-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Recent Orders</h5>
                    <a href="/admin/orders" class="btn-admin-outline btn-sm">View All &rarr;</a>
                </div>
                <% if (stats.recentOrders.length === 0) { %>
                    <div class="a-empty">No orders yet.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table a-table mb-0">
                            <thead>
                                <tr><th>Order ID</th><th>Store</th><th>Customer</th><th>Total</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                <% stats.recentOrders.forEach(order => { %>
                                    <tr>
                                        <td class="fw-semibold"><%= order.orderId %></td>
                                        <td><%= order.stallName %></td>
                                        <td><%= order.customerName %></td>
                                        <td>$<%= order.total.toFixed(2) %></td>
                                        <td><span class="a-badge status-<%= order.status %>"><%= statusLabels[order.status] || order.status %></span></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="a-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Recent Feedback</h5>
                    <a href="/admin/reviews" class="btn-admin-outline btn-sm">View All &rarr;</a>
                </div>
                <% if (stats.recentFeedback.length === 0) { %>
                    <div class="a-empty">No reviews yet.</div>
                <% } else { %>
                    <% stats.recentFeedback.forEach(r => { %>
                        <div class="feedback-row">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="fw-semibold"><%= r.userName %></div>
                                    <div class="small" style="color: var(--a-muted);"><%= r.foodName %><% if (r.stallName) { %> &middot; <%= r.stallName %><% } %></div>
                                </div>
                                <div class="feedback-stars"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5 - r.rating) %></div>
                            </div>
                            <% if (r.comment) { %><p class="mb-0 mt-1 small"><%= r.comment %></p><% } %>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
