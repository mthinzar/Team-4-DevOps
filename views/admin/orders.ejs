<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Orders - FoodHub Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%- include('../partials/admin-styles') %>
    <style>
        .order-row-items { font-size: 0.8rem; color: var(--a-muted); }
    </style>
</head>
<body class="admin-body">

<%- include('../partials/admin-nav', { activePage: 'orders' }) %>

<div class="container-fluid px-3 px-md-4 py-4">
    <h1 class="a-page-title mb-1">All Store Orders</h1>
    <p class="a-page-sub mb-3">Every order placed across the platform, filterable by store, date and status.</p>

    <div class="a-card mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label mb-1">Store</label>
                <select class="form-select" id="filterStore">
                    <option value="all">All stores</option>
                    <% stalls.forEach(s => { %>
                        <option value="<%= s.id %>"><%= s.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1">Date</label>
                <input type="date" class="form-control" id="filterDate">
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1">Status</label>
                <select class="form-select" id="filterStatus">
                    <option value="all">All statuses</option>
                    <% statuses.forEach(s => { %>
                        <option value="<%= s %>"><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn-admin-outline w-100" id="clearFiltersBtn">Clear</button>
            </div>
        </div>
    </div>

    <div class="a-card">
        <p class="small mb-3" style="color: var(--a-muted);"><span id="visibleCount"><%= orders.length %></span> of <%= orders.length %> orders shown</p>
        <% if (orders.length === 0) { %>
            <div class="a-empty">No orders placed yet.</div>
        <% } else { %>
            <div class="table-responsive">
                <table class="table a-table mb-0">
                    <thead>
                        <tr>
                            <th>Order ID</th><th>Store</th><th>Customer</th><th>Items</th>
                            <th>Total</th><th>Payment</th><th>Date</th><th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="ordersBody">
                        <% orders.forEach(order => { %>
                            <tr data-stall="<%= order.stallId %>" data-status="<%= order.status %>"
                                data-date="<%= new Date(order.createdAt).toISOString().slice(0,10) %>">
                                <td class="fw-semibold"><%= order.orderId %></td>
                                <td><%= order.stallName %></td>
                                <td><%= order.customerName %></td>
                                <td class="order-row-items"><%= order.items.map(i => `${i.name} x${i.qty}`).join(', ') %></td>
                                <td>$<%= order.total.toFixed(2) %></td>
                                <td><%= order.paymentMethod || 'Card' %></td>
                                <td class="small"><%= new Date(order.createdAt).toLocaleString() %></td>
                                <td><span class="a-badge status-<%= order.status %>"><%= order.status %></span></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function applyFilters() {
        const store = document.getElementById('filterStore').value;
        const date = document.getElementById('filterDate').value;
        const status = document.getElementById('filterStatus').value;
        let visible = 0;

        document.querySelectorAll('#ordersBody tr').forEach(row => {
            const matchStore = store === 'all' || row.dataset.stall === store;
            const matchDate = !date || row.dataset.date === date;
            const matchStatus = status === 'all' || row.dataset.status === status;
            const show = matchStore && matchDate && matchStatus;
            row.style.display = show ? '' : 'none';
            if (show) visible += 1;
        });

        document.getElementById('visibleCount').textContent = visible;
    }

    document.getElementById('filterStore').addEventListener('change', applyFilters);
    document.getElementById('filterDate').addEventListener('change', applyFilters);
    document.getElementById('filterStatus').addEventListener('change', applyFilters);
    document.getElementById('clearFiltersBtn').addEventListener('click', () => {
        document.getElementById('filterStore').value = 'all';
        document.getElementById('filterDate').value = '';
        document.getElementById('filterStatus').value = 'all';
        applyFilters();
    });
</script>

</body>
</html>
