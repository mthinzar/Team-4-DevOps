<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports &amp; Revenue - FoodHub Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%- include('../partials/admin-styles') %>
    <style>
        .chart-wrap { position: relative; height: 260px; }
        .rank-row { display: flex; justify-content: space-between; align-items: center; padding: 0.55rem 0; border-bottom: 1px solid var(--a-border); }
        .rank-row:last-child { border-bottom: none; }
        .rank-badge { width: 24px; height: 24px; border-radius: 50%; background: #1f2433; color: var(--a-accent); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.75rem; }
        .distribution-row { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.35rem; }
        .distribution-bar-wrap { flex-grow: 1; background: #1f2433; border-radius: 6px; height: 10px; overflow: hidden; }
        .distribution-bar { background: var(--a-accent); height: 100%; }
    </style>
</head>
<body class="admin-body">

<%- include('../partials/admin-nav', { activePage: 'reports' }) %>

<div class="container-fluid px-3 px-md-4 py-4">
    <h1 class="a-page-title mb-1">Reports &amp; Revenue</h1>
    <p class="a-page-sub mb-1">Platform-wide sales, commission and performance analytics.</p>
    <p class="small mb-4" style="color: var(--a-muted);">Commission rate: <span id="commissionRateLabel">-</span> of every order's total (e.g. a $100 order earns the platform $10).</p>

    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3"><div class="a-stat-card"><div class="label">Sales Today</div><div class="value" id="statSalesToday">-</div></div></div>
        <div class="col-6 col-lg-3"><div class="a-stat-card"><div class="label">Sales This Week</div><div class="value" id="statSalesWeek">-</div></div></div>
        <div class="col-6 col-lg-3"><div class="a-stat-card"><div class="label">Sales This Month</div><div class="value" id="statSalesMonth">-</div></div></div>
        <div class="col-6 col-lg-3"><div class="a-stat-card"><div class="label">Cancelled Order Rate</div><div class="value" id="statCancelledRate">-</div></div></div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-4"><div class="a-stat-card"><div class="label">Revenue Today</div><div class="value" id="statRevenueToday">-</div></div></div>
        <div class="col-6 col-lg-4"><div class="a-stat-card"><div class="label">Revenue This Week</div><div class="value" id="statRevenueWeek">-</div></div></div>
        <div class="col-6 col-lg-4"><div class="a-stat-card"><div class="label">Revenue This Month</div><div class="value" id="statRevenueMonth">-</div></div></div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="a-card">
                <h6 class="fw-bold mb-3">Orders by Day (last 7 days)</h6>
                <div class="chart-wrap"><canvas id="ordersByDayChart"></canvas></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="a-card">
                <h6 class="fw-bold mb-3">Monthly Revenue Report (last 6 months)</h6>
                <div class="chart-wrap"><canvas id="revenueByMonthChart"></canvas></div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="a-card">
                <h6 class="fw-bold mb-3">Revenue by Store</h6>
                <div id="revenueByStoreList"><div class="a-empty">Loading…</div></div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="a-card h-100">
                <h6 class="fw-bold mb-3">Most Popular Stores</h6>
                <div id="popularStoresList"><div class="a-empty">Loading…</div></div>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="a-card h-100">
                <h6 class="fw-bold mb-3">Most Popular Dishes</h6>
                <div id="popularDishesList"><div class="a-empty">Loading…</div></div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-12">
            <div class="a-card">
                <h6 class="fw-bold mb-3">Customer Feedback Summary</h6>
                <div class="row">
                    <div class="col-md-3 text-center border-end">
                        <div style="font-size: 2.4rem; font-weight: 800;" id="feedbackAvg">-</div>
                        <div class="small" style="color: var(--a-muted);">average rating</div>
                        <div class="small mt-1" style="color: var(--a-muted);"><span id="feedbackCount">0</span> reviews total</div>
                    </div>
                    <div class="col-md-9" id="feedbackDistribution"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
    fetch('/api/admin/reports-data')
        .then(r => r.json())
        .then(data => {
            if (!data.success) return;

            document.getElementById('commissionRateLabel').textContent = (data.commissionRate * 100).toFixed(0) + '%';
            document.getElementById('statSalesToday').textContent = '$' + data.salesToday.toFixed(2);
            document.getElementById('statSalesWeek').textContent = '$' + data.salesWeek.toFixed(2);
            document.getElementById('statSalesMonth').textContent = '$' + data.salesMonth.toFixed(2);
            document.getElementById('statCancelledRate').textContent = data.cancelledRate.toFixed(1) + '%';
            document.getElementById('statRevenueToday').textContent = '$' + data.revenueToday.toFixed(2);
            document.getElementById('statRevenueWeek').textContent = '$' + data.revenueWeek.toFixed(2);
            document.getElementById('statRevenueMonth').textContent = '$' + data.revenueMonth.toFixed(2);

            new Chart(document.getElementById('ordersByDayChart'), {
                type: 'bar',
                data: { labels: data.ordersByDay.labels, datasets: [{ label: 'Orders', data: data.ordersByDay.counts, backgroundColor: '#f5a623', borderRadius: 6 }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
                    scales: { x: { ticks: { color: '#8b93a7' }, grid: { color: '#262c3b' } }, y: { beginAtZero: true, ticks: { precision: 0, color: '#8b93a7' }, grid: { color: '#262c3b' } } } }
            });

            new Chart(document.getElementById('revenueByMonthChart'), {
                type: 'line',
                data: {
                    labels: data.revenueByMonth.labels,
                    datasets: [
                        { label: 'Sales', data: data.revenueByMonth.sales, borderColor: '#7fb2f0', backgroundColor: 'rgba(127,178,240,0.15)', tension: 0.3, fill: true },
                        { label: 'Commission', data: data.revenueByMonth.commission, borderColor: '#f5a623', backgroundColor: 'rgba(245,166,35,0.15)', tension: 0.3, fill: true }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#eef1f6' } } },
                    scales: { x: { ticks: { color: '#8b93a7' }, grid: { color: '#262c3b' } }, y: { beginAtZero: true, ticks: { color: '#8b93a7' }, grid: { color: '#262c3b' } } } }
            });

            const revenueByStoreList = document.getElementById('revenueByStoreList');
            revenueByStoreList.innerHTML = (data.revenueByStore || []).length === 0
                ? '<div class="a-empty">No sales yet.</div>'
                : data.revenueByStore.map((s, i) => `
                    <div class="rank-row">
                        <div class="d-flex align-items-center gap-2"><span class="rank-badge">${i + 1}</span><span class="fw-semibold">${s.name}</span></div>
                        <span class="small" style="color: var(--a-muted);">$${s.sales.toFixed(2)} sales &middot; $${s.commission.toFixed(2)} commission</span>
                    </div>`).join('');

            const popularStoresList = document.getElementById('popularStoresList');
            popularStoresList.innerHTML = (data.popularStores || []).length === 0
                ? '<div class="a-empty">No orders yet.</div>'
                : data.popularStores.map((s, i) => `
                    <div class="rank-row"><div class="d-flex align-items-center gap-2"><span class="rank-badge">${i + 1}</span><span class="fw-semibold">${s.name}</span></div><span class="small" style="color: var(--a-muted);">${s.orderCount} orders</span></div>`).join('');

            const popularDishesList = document.getElementById('popularDishesList');
            popularDishesList.innerHTML = (data.popularDishes || []).length === 0
                ? '<div class="a-empty">No sales yet.</div>'
                : data.popularDishes.map((d, i) => `
                    <div class="rank-row"><div class="d-flex align-items-center gap-2"><span class="rank-badge">${i + 1}</span><span class="fw-semibold">${d.name}</span></div><span class="small" style="color: var(--a-muted);">${d.qty} sold</span></div>`).join('');

            document.getElementById('feedbackAvg').textContent = data.feedbackSummary.avgRating || '—';
            document.getElementById('feedbackCount').textContent = data.feedbackSummary.totalReviews;

            const dist = data.feedbackSummary.distribution;
            const maxCount = Math.max(1, ...Object.values(dist));
            const distEl = document.getElementById('feedbackDistribution');
            distEl.innerHTML = [5, 4, 3, 2, 1].map(star => `
                <div class="distribution-row">
                    <span style="width: 40px;">${star}★</span>
                    <div class="distribution-bar-wrap"><div class="distribution-bar" style="width:${(dist[star] / maxCount * 100).toFixed(1)}%;"></div></div>
                    <span style="width: 30px; text-align:right;" class="small">${dist[star]}</span>
                </div>`).join('');
        })
        .catch(() => {});
</script>

</body>
</html>
