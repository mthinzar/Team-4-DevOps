<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Users - FoodHub Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%- include('../partials/admin-styles') %>
</head>
<body class="admin-body">

<%- include('../partials/admin-nav', { activePage: 'users' }) %>

<div class="container-fluid px-3 px-md-4 py-4">
    <h1 class="a-page-title mb-1">Manage Users</h1>
    <p class="a-page-sub mb-4">Customer accounts and fellow admin accounts. Merchant accounts are managed from the <a href="/admin/merchants" class="a-accent">Merchants</a> page.</p>

    <ul class="nav nav-tabs mb-3" style="border-color: var(--a-border);">
        <li class="nav-item"><button class="nav-link active" style="background:transparent;color:var(--a-ink);border-color:var(--a-border);" data-bs-toggle="tab" data-bs-target="#customersTab">Customers (<%= customers.length %>)</button></li>
        <li class="nav-item"><button class="nav-link" style="background:transparent;color:var(--a-ink);border-color:var(--a-border);" data-bs-toggle="tab" data-bs-target="#adminsTab">Admin Accounts (<%= admins.length %>)</button></li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="customersTab">
            <div class="a-card">
                <% if (customers.length === 0) { %>
                    <div class="a-empty">No customers yet.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table a-table mb-0">
                            <thead><tr><th>Name</th><th>Phone</th><th>Joined</th><th>Status</th><th></th></tr></thead>
                            <tbody>
                                <% customers.forEach(c => { %>
                                    <tr id="customer-<%= c._id %>">
                                        <td class="fw-semibold"><%= c.name %></td>
                                        <td><%= c.phone %></td>
                                        <td class="small"><%= new Date(c.createdAt).toLocaleDateString() %></td>
                                        <td><span class="a-badge <%= c.disabled ? 'status-rejected' : 'status-approved' %>"><%= c.disabled ? 'Disabled' : 'Active' %></span></td>
                                        <td class="text-end">
                                            <button class="btn-admin-outline btn-sm act-toggle-customer" data-id="<%= c._id %>"><%= c.disabled ? 'Enable' : 'Disable' %></button>
                                            <button class="btn-danger-outline act-delete-customer" data-id="<%= c._id %>">Delete</button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="tab-pane fade" id="adminsTab">
            <div class="d-flex justify-content-end mb-3">
                <button type="button" class="btn-admin" data-bs-toggle="modal" data-bs-target="#addAdminModal">+ Add Admin Account</button>
            </div>
            <div class="a-card">
                <% if (admins.length === 0) { %>
                    <div class="a-empty">No admin accounts yet.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table a-table mb-0">
                            <thead><tr><th>Admin ID</th><th>Name</th><th>Created</th><th></th></tr></thead>
                            <tbody>
                                <% admins.forEach(a => { %>
                                    <tr id="admin-<%= a._id %>">
                                        <td class="fw-semibold"><%= a.adminId %></td>
                                        <td><%= a.name %></td>
                                        <td class="small"><%= new Date(a.createdAt).toLocaleDateString() %></td>
                                        <td class="text-end"><button class="btn-danger-outline act-delete-admin" data-id="<%= a._id %>">Delete</button></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addAdminModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Add Admin Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="addAdminForm">
                <div class="modal-body">
                    <div class="alert alert-danger py-2 small" id="addAdminError" style="display:none;"></div>
                    <div class="mb-3"><label class="form-label">Admin ID</label><input type="text" class="form-control" id="newAdminId" required></div>
                    <div class="mb-3"><label class="form-label">Display Name</label><input type="text" class="form-control" id="newAdminName"></div>
                    <div class="mb-3"><label class="form-label">Password</label><input type="password" class="form-control" id="newAdminPassword" required></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-admin-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-admin">Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.querySelectorAll('.act-toggle-customer').forEach(btn => btn.addEventListener('click', function () {
        const id = this.dataset.id;
        this.disabled = true;
        fetch(`/admin/users/customers/${id}/toggle-disable`, { method: 'POST' })
            .then(r => r.json())
            .then(result => {
                this.disabled = false;
                if (!result.success) { alert(result.message || 'Action failed.'); return; }
                window.location.reload();
            })
            .catch(() => { this.disabled = false; alert('Could not reach the server.'); });
    }));

    document.querySelectorAll('.act-delete-customer').forEach(btn => btn.addEventListener('click', function () {
        if (!confirm('Delete this customer account? This cannot be undone.')) return;
        const id = this.dataset.id;
        fetch(`/admin/users/customers/${id}/delete`, { method: 'POST' })
            .then(r => r.json())
            .then(result => {
                if (!result.success) { alert(result.message || 'Could not delete.'); return; }
                document.getElementById(`customer-${id}`).remove();
            })
            .catch(() => alert('Could not reach the server.'));
    }));

    document.querySelectorAll('.act-delete-admin').forEach(btn => btn.addEventListener('click', function () {
        if (!confirm('Delete this admin account?')) return;
        const id = this.dataset.id;
        fetch(`/admin/users/admins/${id}/delete`, { method: 'POST' })
            .then(r => r.json())
            .then(result => {
                if (!result.success) { alert(result.message || 'Could not delete.'); return; }
                document.getElementById(`admin-${id}`).remove();
            })
            .catch(() => alert('Could not reach the server.'));
    }));

    document.getElementById('addAdminForm').addEventListener('submit', function (e) {
        e.preventDefault();
        const errorEl = document.getElementById('addAdminError');
        errorEl.style.display = 'none';

        fetch('/admin/users/admins/new', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                adminId: document.getElementById('newAdminId').value.trim(),
                name: document.getElementById('newAdminName').value.trim(),
                password: document.getElementById('newAdminPassword').value
            })
        })
        .then(r => r.json())
        .then(result => {
            if (!result.success) { errorEl.textContent = result.message || 'Could not create account.'; errorEl.style.display = 'block'; return; }
            window.location.reload();
        })
        .catch(() => { errorEl.textContent = 'Could not reach the server.'; errorEl.style.display = 'block'; });
    });
</script>

</body>
</html>
