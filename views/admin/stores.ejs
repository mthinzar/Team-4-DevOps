<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Store Sales - FoodHub Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%- include('../partials/admin-styles') %>
    <style>
        .store-row { display: flex; align-items: center; gap: 1rem; padding: 0.9rem 0; border-bottom: 1px solid var(--a-border); }
        .store-row:last-child { border-bottom: none; }
        .store-rank { width: 30px; height: 30px; border-radius: 50%; background: #1f2433; color: var(--a-accent); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; flex-shrink: 0; }
        .store-thumb { width: 44px; height: 44px; border-radius: 10px; object-fit: cover; flex-shrink: 0; }
        .perf-bar-wrap { background: #1f2433; border-radius: 6px; height: 8px; overflow: hidden; margin-top: 0.3rem; }
        .perf-bar { background: var(--a-accent); height: 100%; }
    </style>
</head>
<body class="admin-body">

<%- include('../partials/admin-nav', { activePage: 'stores' }) %>

<div class="container-fluid px-3 px-md-4 py-4">
    <h1 class="a-page-title mb-1">Store Sales</h1>
    <p class="a-page-sub mb-4">Sales, order counts and commission earned per store — best performers first.</p>

    <% const maxSales = Math.max(1, ...breakdown.map(s => s.sales)); %>

    <div class="a-card">
        <% if (breakdown.length === 0) { %>
            <div class="a-empty">No stores yet.</div>
        <% } else { %>
            <% breakdown.forEach((s, i) => { %>
                <div class="store-row">
                    <div class="store-rank">#<%= i + 1 %></div>
                    <img src="<%= s.image %>" alt="<%= s.name %>" class="store-thumb" onerror="this.style.visibility='hidden';">
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="fw-bold">
                                <%= s.name %>
                                <span class="a-badge <%= s.isOpen ? 'status-approved' : 'status-rejected' %> ms-1"><%= s.isOpen ? 'Open' : 'Closed' %></span>
                                <% if (!s.hasOwner) { %><span class="a-badge status-pending ms-1">Unclaimed</span><% } %>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold">$<%= s.sales.toFixed(2) %></div>
                                <div class="small" style="color: var(--a-muted);"><%= s.orderCount %> orders &middot; $<%= s.commission.toFixed(2) %> commission</div>
                            </div>
                        </div>
                        <div class="perf-bar-wrap"><div class="perf-bar" style="width: <%= (s.sales / maxSales * 100).toFixed(1) %>%;"></div></div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
