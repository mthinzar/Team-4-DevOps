<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Store Profile - FoodHub Merchant</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%- include('../partials/merchant-styles') %>
    <style>
        .profile-preview {
            width: 140px; height: 140px; border-radius: 16px; object-fit: cover;
            border: 1px solid #f0d0d4;
        }
    </style>
</head>
<body>

<%- include('../partials/merchant-nav', { activePage: 'profile' }) %>

<div class="container-fluid px-3 px-md-4 py-4">
    <h1 class="m-page-title mb-1">Store Profile</h1>
    <p class="m-page-sub mb-4">Update how your stall appears to customers.</p>

    <div class="m-card" style="max-width: 520px;">
        <div class="alert alert-success py-2 small" id="profileSuccess" style="display:none;">Your store profile has been updated.</div>
        <div class="alert alert-danger py-2 small" id="profileError" style="display:none;"></div>

        <form id="profileForm">
            <div class="text-center mb-3">
                <img src="<%= stall.image %>" alt="<%= stall.name %>" class="profile-preview" id="profileImagePreview">
            </div>

            <div class="mb-3">
                <label class="form-label">Store Name</label>
                <input type="text" class="form-control" id="storeName" value="<%= stall.name %>" required maxlength="60">
            </div>

            <div class="mb-3">
                <label class="form-label">Store Picture</label>
                <input type="file" class="form-control" id="storeImage" accept="image/*">
                <div class="form-text">Leave empty to keep your current picture.</div>
            </div>

            <button type="submit" class="btn-brand w-100" id="btnSaveProfile">Save Changes</button>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.getElementById('storeImage').addEventListener('change', function () {
        if (this.files && this.files[0]) {
            document.getElementById('profileImagePreview').src = URL.createObjectURL(this.files[0]);
        }
    });

    document.getElementById('profileForm').addEventListener('submit', function (event) {
        event.preventDefault();

        const successEl = document.getElementById('profileSuccess');
        const errorEl = document.getElementById('profileError');
        successEl.style.display = 'none';
        errorEl.style.display = 'none';

        const formData = new FormData();
        formData.append('name', document.getElementById('storeName').value.trim());
        const imageFile = document.getElementById('storeImage').files[0];
        if (imageFile) formData.append('image', imageFile);

        const btn = document.getElementById('btnSaveProfile');
        btn.disabled = true;
        btn.textContent = 'Saving...';

        fetch('/merchant/profile', { method: 'POST', body: formData })
            .then(r => r.json())
            .then(result => {
                btn.disabled = false;
                btn.textContent = 'Save Changes';
                if (!result.success) {
                    errorEl.textContent = result.message || 'Could not update your profile.';
                    errorEl.style.display = 'block';
                    return;
                }
                successEl.style.display = 'block';
                window.scrollTo({ top: 0, behavior: 'smooth' });
            })
            .catch(() => {
                btn.disabled = false;
                btn.textContent = 'Save Changes';
                errorEl.textContent = 'Could not reach the server. Please try again.';
                errorEl.style.display = 'block';
            });
    });
</script>

</body>
</html>
