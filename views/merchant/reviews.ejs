<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Reviews - FoodHub Merchant</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%- include('../partials/merchant-styles') %>
    <style>
        .review-card { background:#fff; border:1px solid #f0d0d4; border-radius:14px; padding:1.1rem 1.25rem; margin-bottom:0.9rem; }
        .review-stars { color:#f5a623; letter-spacing:1px; }
        .sort-pill {
            border: 1px solid var(--brand); color: var(--brand); background:#fff;
            border-radius: 30px; padding: 0.35rem 1rem; font-size: 0.85rem; font-weight: 600; text-decoration:none; display:inline-block;
        }
        .sort-pill.active { background: var(--brand); color:#fff; }
    </style>
</head>
<body>

<%- include('../partials/merchant-nav', { activePage: 'reviews' }) %>

<div class="container-fluid px-3 px-md-4 py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="m-page-title mb-1">Customer Reviews</h1>
            <p class="m-page-sub mb-0">Ratings & comments left on your dishes.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/merchant/reviews?sort=newest" class="sort-pill <%= sort === 'newest' ? 'active' : '' %>">Newest</a>
            <a href="/merchant/reviews?sort=highest" class="sort-pill <%= sort === 'highest' ? 'active' : '' %>">Highest Rated</a>
        </div>
    </div>

    <% if (reviews.length === 0) { %>
        <div class="m-card m-empty">No reviews yet for your dishes.</div>
    <% } else { %>
        <% reviews.forEach(review => { %>
            <div class="review-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="fw-bold"><%= review.userName %></div>
                        <div class="text-muted small">on <span class="fw-semibold"><%= review.foodName %></span> &middot; <%= new Date(review.createdAt).toLocaleDateString() %></div>
                    </div>
                    <div class="review-stars"><%= '★'.repeat(review.rating) %><%= '☆'.repeat(5 - review.rating) %></div>
                </div>
                <% if (review.comment) { %>
                    <p class="mb-0 mt-2 small"><%= review.comment %></p>
                <% } %>
            </div>
        <% }) %>
    <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
