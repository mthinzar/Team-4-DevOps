<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Management - FoodHub Merchant</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%- include('../partials/merchant-styles') %>
    <style>
        .order-card { background:#fff; border:1px solid #f0d0d4; border-radius:14px; padding:1.1rem 1.25rem; margin-bottom:1rem; }
        .order-items-list { font-size: 0.85rem; }
        .order-items-list li { display:flex; justify-content:space-between; padding: 0.15rem 0; }
        .prep-adjust button { width: 30px; height: 30px; border-radius: 8px; border: 1px solid #e0a4ac; background:#fff; font-weight:700; }
        .filter-pill {
            border: 1px solid var(--brand); color: var(--brand); background:#fff;
            border-radius: 30px; padding: 0.3rem 0.9rem; font-size: 0.82rem; font-weight: 600;
        }
        .filter-pill.active { background: var(--brand); color: #fff; }
    </style>
</head>
<body>

<%- include('../partials/merchant-nav', { activePage: 'orders' }) %>

<div class="container-fluid px-3 px-md-4 py-4">
    <h1 class="m-page-title mb-1">Order Management</h1>
    <p class="m-page-sub mb-3">Only orders placed with your stall show up here.</p>

    <div class="d-flex flex-wrap gap-2 mb-3" id="statusFilters">
        <button class="filter-pill active" data-filter="all">All</button>
        <% statuses.forEach(s => { %>
            <button class="filter-pill" data-filter="<%= s %>"><%= s.charAt(0).toUpperCase() + s.slice(1) %></button>
        <% }) %>
    </div>

    <% if (orders.length === 0) { %>
        <div class="m-card m-empty">No orders yet.</div>
    <% } else { %>
        <div id="ordersList">
            <% orders.forEach(order => { %>
                <div class="order-card" data-order-status="<%= order.status %>">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                        <div>
                            <div class="fw-bold"><%= order.orderId %> <span class="badge-status status-<%= order.status %> ms-1" id="statusBadge-<%= order.orderId %>"><%= order.status %></span></div>
                            <div class="text-muted small">
                                <%= order.customerName %> &middot; <%= new Date(order.createdAt).toLocaleString() %> &middot; <%= order.paymentMethod || 'Card' %>
                            </div>
                        </div>
                        <div class="fw-bold">$<%= order.total.toFixed(2) %></div>
                    </div>

                    <ul class="order-items-list list-unstyled mb-2">
                        <% order.items.forEach(item => { %>
                            <li><span><%= item.name %> &times; <%= item.qty %></span><span>$<%= (item.price * item.qty).toFixed(2) %></span></li>
                        <% }) %>
                    </ul>

                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div>
                            <label class="form-label mb-1 small">Order Status</label>
                            <select class="form-select form-select-sm status-select" data-order-id="<%= order.orderId %>" style="width:auto;">
                                <% statuses.forEach(s => { %>
                                    <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div>
                            <label class="form-label mb-1 small d-block">Preparation Time (queue management)</label>
                            <div class="prep-adjust d-flex align-items-center gap-2">
                                <button type="button" class="btn-prep" data-order-id="<%= order.orderId %>" data-delta="-5">&minus;5m</button>
                                <span class="small text-muted" id="prepLabel-<%= order.orderId %>">
                                    <%= Math.round(order.prepTimeSeconds / 60) %> min total
                                </span>
                                <button type="button" class="btn-prep" data-order-id="<%= order.orderId %>" data-delta="5">+5m</button>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.querySelectorAll('#statusFilters .filter-pill').forEach(pill => {
        pill.addEventListener('click', () => {
            document.querySelectorAll('#statusFilters .filter-pill').forEach(p => p.classList.remove('active'));
            pill.classList.add('active');
            const filter = pill.dataset.filter;
            document.querySelectorAll('.order-card').forEach(card => {
                card.style.display = (filter === 'all' || card.dataset.orderStatus === filter) ? '' : 'none';
            });
        });
    });

    document.querySelectorAll('.status-select').forEach(select => {
        select.addEventListener('change', function () {
            const orderId = this.dataset.orderId;
            const status = this.value;
            this.disabled = true;
            fetch(`/merchant/orders/${orderId}/status`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status })
            })
            .then(r => r.json())
            .then(result => {
                this.disabled = false;
                if (!result.success) return;
                const badge = document.getElementById(`statusBadge-${orderId}`);
                badge.className = `badge-status status-${status} ms-1`;
                badge.textContent = status;
                this.closest('.order-card').dataset.orderStatus = status;
                const activeFilter = document.querySelector('#statusFilters .filter-pill.active').dataset.filter;
                if (activeFilter !== 'all' && activeFilter !== status) {
                    this.closest('.order-card').style.display = 'none';
                }
            })
            .catch(() => { this.disabled = false; });
        });
    });

    document.querySelectorAll('.btn-prep').forEach(btn => {
        btn.addEventListener('click', function () {
            const orderId = this.dataset.orderId;
            const delta = parseInt(this.dataset.delta, 10);
            this.disabled = true;
            fetch(`/merchant/orders/${orderId}/preptime`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ deltaMinutes: delta })
            })
            .then(r => r.json())
            .then(result => {
                this.disabled = false;
                if (!result.success) return;
                document.getElementById(`prepLabel-${orderId}`).textContent =
                    `${Math.round(result.prepTimeSeconds / 60)} min total`;
            })
            .catch(() => { this.disabled = false; });
        });
    });
</script>

</body>
</html>
