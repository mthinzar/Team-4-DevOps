<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Management - FoodHub Merchant</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%- include('../partials/merchant-styles') %>
    <style>
        .order-card { background:#fff; border:1px solid #f0d0d4; border-radius:14px; padding:1.1rem 1.25rem; margin-bottom:1rem; }
        .order-items-list { font-size: 0.85rem; }
        .order-items-list li { display:flex; justify-content:space-between; padding: 0.15rem 0; }
        .prep-adjust button { width: 30px; height: 30px; border-radius: 8px; border: 1px solid #e0a4ac; background:#fff; font-weight:700; }
        .filter-pill {
            border: 1px solid var(--brand); color: var(--brand); background:#fff;
            border-radius: 30px; padding: 0.3rem 0.9rem; font-size: 0.82rem; font-weight: 600;
        }
        .filter-pill.active { background: var(--brand); color: #fff; }
        .pay-pill {
            display: inline-block; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.3px;
            border-radius: 20px; padding: 0.12rem 0.5rem; margin-top: 0.25rem;
        }
        .pay-pill.paid { background: #e4f5ec; color: #1a7f4b; }
        .pay-pill.unpaid { background: #fdeaea; color: #c52d39; }
        .btn-mark-paid {
            display: block; margin-top: 0.3rem; font-size: 0.7rem; font-weight: 600;
            border: 1px solid var(--brand); color: var(--brand); background: #fff;
            border-radius: 20px; padding: 0.15rem 0.6rem;
        }
        .btn-mark-paid:hover { background: var(--brand); color: #fff; }

        .order-actions { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
        .btn-step {
            background: var(--brand); color: #fff; border: none; border-radius: 10px;
            padding: 0.5rem 1.1rem; font-weight: 600; font-size: 0.85rem;
        }
        .btn-step:hover:not(:disabled) { background: #c52d39; }
        .btn-step:disabled { opacity: 0.6; }
        .btn-cancel-order {
            background: #fff; color: #7a7a7a; border: 1px solid #ddd;
            border-radius: 10px; padding: 0.5rem 0.9rem; font-weight: 600; font-size: 0.82rem;
        }
        .btn-cancel-order:hover { border-color: #c0392b; color: #c0392b; }
        .step-done { font-size: 0.85rem; font-weight: 600; color: #7a7a7a; }
    </style>
</head>
<body>

<%- include('../partials/merchant-nav', { activePage: 'orders' }) %>

<div class="container-fluid px-3 px-md-4 py-4">
    <h1 class="m-page-title mb-1">Order Management</h1>
    <p class="m-page-sub mb-3">Only orders placed with your stall show up here.</p>

    <div class="d-flex flex-wrap gap-2 mb-3" id="statusFilters">
        <button class="filter-pill active" data-filter="all">All</button>
        <% ORDER_FLOW.concat('cancelled').forEach(s => { %>
            <button class="filter-pill" data-filter="<%= s %>"><%= ORDER_STATUS_LABELS[s] %></button>
        <% }) %>
    </div>

    <% if (orders.length === 0) { %>
        <div class="m-card m-empty">No orders yet.</div>
    <% } else { %>
        <div id="ordersList">
            <% orders.forEach(order => { %>
                <div class="order-card" data-order-status="<%= order.status %>" data-order-id="<%= order.orderId %>">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                        <div>
                            <div class="fw-bold"><%= order.orderId %> <span class="badge-status status-<%= order.status %> ms-1" id="statusBadge-<%= order.orderId %>"><%= ORDER_STATUS_LABELS[order.status] %></span></div>
                            <div class="text-muted small">
                                <%= order.customerName %> &middot; <%= new Date(order.createdAt).toLocaleString() %>
                                &middot; <%= PAYMENT_LABELS[order.paymentMethod] || 'Card' %>
                                <% if (order.paymentRef) { %><span class="text-muted">(<%= order.paymentRef %>)</span><% } %>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold">$<%= order.total.toFixed(2) %></div>
                            <% if (order.paymentStatus === 'unpaid') { %>
                                <span class="pay-pill unpaid" id="payPill-<%= order.orderId %>">Unpaid</span>
                                <button type="button" class="btn-mark-paid" data-order-id="<%= order.orderId %>">Mark paid</button>
                            <% } else { %>
                                <span class="pay-pill paid">Paid</span>
                            <% } %>
                        </div>
                    </div>

                    <ul class="order-items-list list-unstyled mb-2">
                        <% order.items.forEach(item => { %>
                            <li><span><%= item.name %> &times; <%= item.qty %></span><span>$<%= (item.price * item.qty).toFixed(2) %></span></li>
                        <% }) %>
                    </ul>

                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div class="order-actions" id="actions-<%= order.orderId %>">
                            <% if (NEXT_STEP[order.status]) { %>
                                <button type="button" class="btn-step"
                                        data-order-id="<%= order.orderId %>"
                                        data-next="<%= NEXT_STEP[order.status].status %>">
                                    <%= NEXT_STEP[order.status].label %> &rarr;
                                </button>
                            <% } else { %>
                                <span class="step-done"><%= ORDER_STATUS_LABELS[order.status] %></span>
                            <% } %>

                            <% if (CANCELLABLE.includes(order.status)) { %>
                                <button type="button" class="btn-cancel-order" data-order-id="<%= order.orderId %>">Cancel</button>
                            <% } %>
                        </div>

                        <div>
                            <label class="form-label mb-1 small d-block">Preparation Time (queue management)</label>
                            <div class="prep-adjust d-flex align-items-center gap-2">
                                <button type="button" class="btn-prep" data-order-id="<%= order.orderId %>" data-delta="-5">&minus;5m</button>
                                <span class="small text-muted" id="prepLabel-<%= order.orderId %>">
                                    <%= Math.round(order.prepTimeSeconds / 60) %> min total
                                </span>
                                <button type="button" class="btn-prep" data-order-id="<%= order.orderId %>" data-delta="5">+5m</button>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.querySelectorAll('#statusFilters .filter-pill').forEach(pill => {
        pill.addEventListener('click', () => {
            document.querySelectorAll('#statusFilters .filter-pill').forEach(p => p.classList.remove('active'));
            pill.classList.add('active');
            const filter = pill.dataset.filter;
            document.querySelectorAll('.order-card').forEach(card => {
                card.style.display = (filter === 'all' || card.dataset.orderStatus === filter) ? '' : 'none';
            });
        });
    });

    // Moves an order one step along the flow (or cancels it) and re-renders
    // just that card's action area with whatever the server says comes next.
    function changeStatus(orderId, status, button) {
        button.disabled = true;
        fetch(`/merchant/orders/${orderId}/status`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status })
        })
        .then(r => r.json())
        .then(result => {
            if (!result.success) {
                button.disabled = false;
                alert(result.message || 'Could not update this order.');
                return;
            }

            const badge = document.getElementById(`statusBadge-${orderId}`);
            badge.className = `badge-status status-${result.status} ms-1`;
            badge.textContent = result.label;

            const card = document.querySelector(`.order-card[data-order-id="${orderId}"]`);
            card.dataset.orderStatus = result.status;

            const actions = document.getElementById(`actions-${orderId}`);
            actions.innerHTML = result.nextStep
                ? `<button type="button" class="btn-step" data-order-id="${orderId}" data-next="${result.nextStep.status}">${result.nextStep.label} &rarr;</button>`
                : `<span class="step-done">${result.label}</span>`;
            if (result.cancellable) {
                actions.insertAdjacentHTML('beforeend',
                    `<button type="button" class="btn-cancel-order" data-order-id="${orderId}">Cancel</button>`);
            }

            const activeFilter = document.querySelector('#statusFilters .filter-pill.active').dataset.filter;
            if (activeFilter !== 'all' && activeFilter !== result.status) {
                card.style.display = 'none';
            }
        })
        .catch(() => { button.disabled = false; });
    }

    // Delegated so the buttons keep working after a card re-renders itself.
    document.addEventListener('click', event => {
        const step = event.target.closest('.btn-step');
        if (step) {
            changeStatus(step.dataset.orderId, step.dataset.next, step);
            return;
        }
        const cancel = event.target.closest('.btn-cancel-order');
        if (cancel && confirm('Cancel this order? The customer will see it as cancelled.')) {
            changeStatus(cancel.dataset.orderId, 'cancelled', cancel);
        }
    });

    document.querySelectorAll('.btn-mark-paid').forEach(btn => {
        btn.addEventListener('click', function () {
            const orderId = this.dataset.orderId;
            this.disabled = true;
            fetch(`/merchant/orders/${orderId}/mark-paid`, { method: 'POST' })
                .then(r => r.json())
                .then(result => {
                    if (!result.success) { this.disabled = false; return; }
                    const pill = document.getElementById(`payPill-${orderId}`);
                    pill.className = 'pay-pill paid';
                    pill.textContent = 'Paid';
                    this.remove();
                })
                .catch(() => { this.disabled = false; });
        });
    });

    document.querySelectorAll('.btn-prep').forEach(btn => {
        btn.addEventListener('click', function () {
            const orderId = this.dataset.orderId;
            const delta = parseInt(this.dataset.delta, 10);
            this.disabled = true;
            fetch(`/merchant/orders/${orderId}/preptime`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ deltaMinutes: delta })
            })
            .then(r => r.json())
            .then(result => {
                this.disabled = false;
                if (!result.success) return;
                document.getElementById(`prepLabel-${orderId}`).textContent =
                    `${Math.round(result.prepTimeSeconds / 60)} min total`;
            })
            .catch(() => { this.disabled = false; });
        });
    });
</script>

</body>
</html>
